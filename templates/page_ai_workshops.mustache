{{!
    AI Tools Workshop Redesigned Template
}}
{{> local_univerziaai/navbar }}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>

    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <span class="badge">AI Mastery Workshop</span>
                <h1 class="hero-title">{{{hero_title}}}</h1>
                <p class="hero-subtitle">{{{hero_subtitle}}}</p>

                <div class="hero-checklist-container" style="margin-bottom: var(--space-xl);">
                    {{#hero_checklist}}
                    <div class="checklist-item">
                        <span class="check-icon"><i class="fa-solid fa-check"></i></span> <span>{{.}}</span>
                    </div>
                    {{/hero_checklist}}
                </div>
                
                 <div class="hero-stats" style="margin-bottom: var(--space-lg);">
                    {{#session_details}}
                    <div class="stat-item">
                        <div class="stat-number" style="font-size: 1.5rem;">{{{icon}}}</div>
                        <div class="stat-label">{{text}}</div>
                    </div>
                    {{/session_details}}
                </div>

                <div class="hero-cta">
                    <button class="btn-primary btn-large pulse register-workshop-btn">
                        <span>Register for Workshop</span>
                        <span style="font-size: 0.8em; opacity: 0.9; margin-left: 5px;">(₹{{cta_price_current}} only)</span>
                    </button>
                    <button class="btn-secondary btn-large" onclick="document.getElementById('curriculum').scrollIntoView({behavior: 'smooth'})">
                        View Curriculum
                    </button>
                </div>
            </div>

            <div class="hero-visual">
                <div class="visual-card card-1">
                    <div class="card-icon"><i class="fa-solid fa-robot"></i></div>
                    <div>
                        <div class="card-title">Prompt Engineering</div>
                        <div class="card-progress"><div class="progress-bar" style="width: 85%"></div></div>
                    </div>
                </div>
                <div class="visual-card card-2">
                    <div class="card-icon"><i class="fa-solid fa-chart-simple"></i></div>
                    <div>
                        <div class="card-title">Data Analysis</div>
                        <div class="card-progress"><div class="progress-bar" style="width: 92%"></div></div>
                    </div>
                </div>
                <!-- Placeholder for instructor image if needed, for now utilizing abstract cards -->
            </div>
        </div>
    </div>
</section>

<!-- Warning / Why Join -->
<section class="section-white">
    <div class="container">
        <div class="section-header">
            <div class="section-badge">Why Join?</div>
            <h2 class="section-title">Upgrade Your Career</h2>
            <p class="section-subtitle">Don't get left behind in the AI revolution.</p>
        </div>

        <div class="features-grid">
            {{#why_join}}
            <div class="feature-card">
                <div class="feature-icon">
                    <div class="icon-bg"></div>
                    {{{icon}}}
                </div>
                <h3 class="feature-title">{{title}}</h3>
                <p class="feature-description">{{desc}}</p>
            </div>
            {{/why_join}}
        </div>
    </div>
</section>

<!-- Job Market Stats (Redesigned) -->
<section class="stats-section" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white; position: relative; overflow: hidden;">
    <!-- Background Accents -->
    <div style="position: absolute; top: -100px; left: -100px; width: 400px; height: 400px; background: var(--primary-500); filter: blur(150px); opacity: 0.15; border-radius: 50%;"></div>
    <div style="position: absolute; bottom: -100px; right: -100px; width: 400px; height: 400px; background: #3b82f6; filter: blur(150px); opacity: 0.15; border-radius: 50%;"></div>

    <div class="container" style="position: relative; z-index: 2;">
        <div class="section-header">
            <div class="section-badge" style="background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2);">Market Reality</div>
            <h2 class="section-title" style="color: white;">AI Impact on <span class="gradient-text">Jobs</span></h2>
            <p class="section-subtitle" style="color: rgba(255,255,255,0.7);">The landscape of work is shifting. Here's what the data says.</p>
        </div>
        
        <div class="stats-grid impact-stats-grid">
             {{#market_reality_stats}}
            <div class="impact-stat-card {{type}}">
                <div class="card-glow"></div>
                <div class="stat-icon-wrapper">{{{icon}}}</div>
                <div class="stat-content">
                    <div class="stat-big-number">{{value}}</div>
                    <div class="stat-title">{{title}}</div>
                    <p class="stat-desc">{{desc}}</p>
                </div>
                <div class="stat-source-badge">
                    <i class="fa-solid fa-quote-left"></i> <span>{{source}}</span>
                </div>
            </div>
            {{/market_reality_stats}}
        </div>

        <div class="section-badge" style="background: rgba(255,255,255,0.1); color: #fff; margin: 60px auto 20px; display: table; border: 1px solid rgba(255,255,255,0.2);">Media Coverage</div>
        <h2 class="section-title" style="color: white; text-align: center; margin-bottom: 40px;">Rise in <span class="gradient-text">AI-related jobs</span></h2>

        <div class="news-grid-cards">
            {{#news_articles}}
            <div class="news-card">
                <div class="news-header">
                    <span class="news-source">{{source}}</span>
                </div>
                <h3 class="news-headline">{{headline}}</h3>
                <div class="news-footer">
                    <span class="read-more">Read Full Story <i class="fa-solid fa-arrow-right"></i></span>
                </div>
            </div>
            {{/news_articles}}
        </div>
    </div>
</section>

<style>
