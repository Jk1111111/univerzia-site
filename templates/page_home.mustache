<script>
document.addEventListener('DOMContentLoaded', function() {
    const departmentRadios = document.querySelectorAll('input[name="department"]');
    const dropdownLabel = document.getElementById('dropdownLabel');
    const courseServiceSelect = document.getElementById('courseServiceSelect');
    
    // Data from Mustache
    const academicOptions = [
        {{#admission_form_options.academic}}
        "{{.}}",
        {{/admission_form_options.academic}}
    ];
    
    const serviceOptions = [
        {{#admission_form_options.services}}
        "{{.}}",
        {{/admission_form_options.services}}
    ];
    
    function updateDropdown(dept) {
        // Clear existing
        courseServiceSelect.innerHTML = '<option value="">Select Option</option>';
        
        let options = [];
        if (dept === 'Academic') {
            dropdownLabel.textContent = 'Select Course';
            options = academicOptions;
        } else {
            dropdownLabel.textContent = 'Select Service';
            options = serviceOptions;
        }
        
        options.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt;
            option.textContent = opt;
            courseServiceSelect.appendChild(option);
        });
    }
    
    departmentRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
            updateDropdown(e.target.value);
        });
    });
    
    // Form Submission
    const form = document.getElementById('admissionForm');
    const messageDiv = document.getElementById('formMessage');
    const submitBtn = form.querySelector('.apply-btn');
    const formContainer = document.getElementById('registrationFormContainer');
    const successContainer = document.getElementById('registrationSuccessContainer');
    const registerAnotherBtn = document.getElementById('registerAnotherBtn');
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
        messageDiv.textContent = '';
        messageDiv.className = 'form-message';
        
        const formData = new FormData(form);
        
        fetch('{{{pluginurl}}}/ajax_submit_admission.php', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Show success container
                formContainer.style.display = 'none';
                successContainer.style.display = 'flex';
                
                form.reset();
                updateDropdown('Academic');
            } else {
                messageDiv.textContent = data.message || 'An error occurred.';
                messageDiv.classList.add('error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            messageDiv.textContent = 'Network error. Please try again.';
            messageDiv.classList.add('error');
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Apply Now';
        });
    });
    
    if (registerAnotherBtn) {
        registerAnotherBtn.addEventListener('click', function() {
            successContainer.style.display = 'none';
            formContainer.style.display = 'block';
            messageDiv.textContent = '';
        });
    }
});
</script>

