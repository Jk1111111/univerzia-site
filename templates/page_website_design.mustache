<script>
document.addEventListener('DOMContentLoaded', function() {
    // Accordion Logic
    const accordionItems = document.querySelectorAll('.accordion-item');
    if(accordionItems.length > 0) {
        // Set first item active if none are active
        if(!document.querySelector('.accordion-item.active')) {
            accordionItems[0].classList.add('active');
        }
        
        accordionItems.forEach(item => {
            item.querySelector('.accordion-header').addEventListener('click', function() {
                const isActive = item.classList.contains('active');
                accordionItems.forEach(i => i.classList.remove('active'));
                if (!isActive) {
                    item.classList.add('active');
                }
            });
        });
    }

    // Interactive Stats (Simple Counter)
    const stats = document.querySelectorAll('.lms-stat-num');
    stats.forEach(stat => {
        // Just simple animation or leave standard
    });
    
    // Form Logic (Same as LMS)
    const lmsDepartmentRadios = document.querySelectorAll('#lmsAdmissionForm input[name="department"]');
    const lmsDropdownLabel = document.getElementById('lmsDropdownLabel');
    const lmsCourseServiceSelect = document.getElementById('lmsCourseServiceSelect');
    
    // Data from Mustache (re-using variables if available, otherwise defaulting)
    // Note: if admission_form_options is empty, this might be blank. 
    // Assuming data is passed correctly from website_design.php
    
    const lmsAcademicOptions = [
        {{#admission_form_options.academic}}
        "{{.}}",
        {{/admission_form_options.academic}}
    ];
    
    const lmsServiceOptions = [
        {{#admission_form_options.services}}
        "{{.}}",
        {{/admission_form_options.services}}
    ];
    
    function lmsUpdateDropdown(dept) {
        lmsCourseServiceSelect.innerHTML = '<option value="">Select Option</option>';
        
        // Safety check if options are empty
        if(lmsAcademicOptions.length === 0 && lmsServiceOptions.length === 0) return;

        let options = [];
        if (dept === 'Academic') {
            lmsDropdownLabel.textContent = 'Select Course';
            options = lmsAcademicOptions;
        } else {
            lmsDropdownLabel.textContent = 'Select Service';
            options = lmsServiceOptions;
        }
        
        options.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt;
            option.textContent = opt;
            lmsCourseServiceSelect.appendChild(option);
        });
    }
    
    if(lmsDepartmentRadios.length > 0) {
        lmsDepartmentRadios.forEach(radio => {
            radio.addEventListener('change', (e) => {
                lmsUpdateDropdown(e.target.value);
            });
        });
        
        // Initialize logic
        // Check which one is checked
        const checked = document.querySelector('#lmsAdmissionForm input[name="department"]:checked');
        if(checked) {
            lmsUpdateDropdown(checked.value);
        }
    }
    
    // Form Submission
    const lmsForm = document.getElementById('lmsAdmissionForm');
    const lmsMessageDiv = document.getElementById('lmsFormMessage');
    const lmsSubmitBtn = lmsForm ? lmsForm.querySelector('.lms-apply-btn') : null;
    const lmsFormContainer = document.getElementById('lmsFormContainer');
    const lmsSuccessContainer = document.getElementById('lmsSuccessContainer');
    const lmsSendAnotherBtn = document.getElementById('lmsSendAnotherBtn');
    
    if(lmsForm) {
        lmsForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            lmsSubmitBtn.disabled = true;
            lmsSubmitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
            lmsMessageDiv.textContent = '';
            lmsMessageDiv.className = 'lms-form-message';
            
            const formData = new FormData(lmsForm);
            
            fetch('{{{pluginurl}}}/ajax_submit_admission.php', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    lmsFormContainer.style.display = 'none';
                    lmsSuccessContainer.style.display = 'flex';
                    lmsForm.reset();
                    // Reset dropdown to default
                    if(lmsDepartmentRadios.length > 0) lmsUpdateDropdown('Academic');
                    
                    // Reset radio to default Academic if needed
                     const acRadio = document.querySelector('input[name="department"][value="Academic"]');
                     if(acRadio) acRadio.checked = true;

                } else {
                    lmsMessageDiv.textContent = data.message || 'An error occurred.';
                    lmsMessageDiv.classList.add('error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                lmsMessageDiv.textContent = 'Network error. Please try again.';
                lmsMessageDiv.classList.add('error');
            })
            .finally(() => {
                lmsSubmitBtn.disabled = false;
                lmsSubmitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Send Request';
            });
        });
    }
    
    if (lmsSendAnotherBtn) {
        lmsSendAnotherBtn.addEventListener('click', function() {
            lmsSuccessContainer.style.display = 'none';
            lmsFormContainer.style.display = 'block';
            lmsMessageDiv.textContent = '';
        });
    }
});
</script>
