{{!
    SEO-optimized About page template for Univerzia AI
    Includes proper H1/H2 heading hierarchy and keyword-rich content
}}
{{> local_univerziaai/navbar }}

<!-- About Hero Section -->
<section class="about-hero">
    <div class="container">
        <div class="badge">About Univerzia AI</div>
        <h1 class="hero-title" style="font-size: 3.5rem;">About <span class="gradient-text">Univerzia AI</span> – AI Powered Learning Platform</h1>
        <p class="hero-subtitle" style="max-width: 720px; margin: 0 auto;">
            Univerzia AI is a unique ecosystem where a top-tier digital agency meets an advanced AI-powered learning platform.
            Empowering businesses and learners across India with innovative technology solutions.
        </p>
    </div>
</section>

<!-- What is Univerzia AI Section -->
<section class="about-section">
    <div class="container">
        <div class="about-section-header">
            <div class="section-badge" style="display: inline-block;">Our Identity</div>
            <h2>What is <span class="gradient-text">Univerzia AI</span></h2>
        </div>
        <div class="about-content" style="max-width: 900px;">
            <p>
                Univerzia AI is an AI-powered EdTech platform and full-service digital agency headquartered in Varanasi, India.
                Founded with the vision of bridging the gap between industry demands and academic learning, Univerzia AI combines
                real-world project experience with structured AI-driven education to produce job-ready professionals.
            </p>
            <p>
                At its core, Univerzia AI operates as a dual-entity organization. On one side, Univerzia AI functions as a
                digital agency that delivers high-quality web development, LMS solutions, e-commerce platforms, and digital
                marketing services to clients across India and beyond. On the other side, Univerzia AI runs an advanced tech
                academy where students learn directly from live projects, gaining practical skills that traditional education
                often lacks.
            </p>
            <p>
                Univerzia AI Pvt Ltd is officially registered as a private limited company committed to democratizing access
                to quality AI education and enterprise-grade technology services.
            </p>
        </div>
    </div>
</section>

<!-- Mission of Univerzia AI Section -->
<section class="about-section">
    <div class="container">
        <div class="about-section-header">
            <div class="section-badge" style="display: inline-block;">Our Mission</div>
            <h2>Mission of <span class="gradient-text">Univerzia AI</span></h2>
        </div>
        <div class="about-content" style="max-width: 900px;">
            <p>
                The mission of Univerzia AI is to make cutting-edge AI education and technology services accessible to
                everyone. Univerzia AI believes that quality learning should not be limited by geography or economic
                background. Through its AI-powered learning platform, Univerzia AI aims to equip students, professionals,
                and businesses with the tools they need to thrive in the rapidly evolving digital landscape.
            </p>
            <p>
                Univerzia AI is dedicated to fostering innovation by integrating artificial intelligence into every aspect
                of learning and business operations. From AI-driven course recommendations to intelligent chatbot solutions,
                the Univerzia AI platform leverages modern AI capabilities to create personalized learning experiences and
                efficient business workflows.
            </p>
        </div>
        <div class="about-features-grid">
            <div class="about-feature-card">
                <div class="about-feature-icon"><i class="fa-solid fa-lightbulb"></i></div>
                <h3>Innovation First</h3>
                <p>Univerzia AI integrates the latest AI technologies into education and business solutions to stay ahead of industry trends.</p>
            </div>
            <div class="about-feature-card">
                <div class="about-feature-icon" style="background: #d1fae5;"><i class="fa-solid fa-users"></i></div>
                <h3>Accessible Education</h3>
                <p>Univerzia AI makes high-quality tech education accessible to learners from all backgrounds across India.</p>
            </div>
            <div class="about-feature-card">
                <div class="about-feature-icon" style="background: #e0e7ff;"><i class="fa-solid fa-handshake"></i></div>
                <h3>Industry Partnership</h3>
                <p>Univerzia AI partners with businesses to deliver real-world projects that double as training grounds for students.</p>
            </div>
        </div>
    </div>
</section>

<!-- Univerzia AI LMS Platform Section -->
<section class="about-section">
    <div class="container">
        <div class="about-section-header">
            <div class="section-badge" style="display: inline-block;">Our Platform</div>
            <h2>Univerzia AI <span class="gradient-text">LMS Platform</span></h2>
        </div>
        <div class="about-content" style="max-width: 900px;">
            <p>
                The Univerzia AI LMS Platform is a state-of-the-art learning management system built on enterprise-grade
                technology. Designed to support both individual learners and institutional deployments, the Univerzia AI
                LMS provides a comprehensive suite of tools for course creation, student management, assessments, and
                progress tracking.
            </p>
            <p>
                What sets the Univerzia AI LMS apart from conventional learning management systems is its deep integration
                with artificial intelligence. The Univerzia AI platform uses AI to recommend courses based on learner
                behavior, automate grading, generate insights for educators, and provide intelligent tutoring support
                through built-in AI chatbots.
            </p>
            <p>
                Built on the robust Moodle framework, the Univerzia AI LMS platform ensures reliability, scalability,
                and compliance with global education standards. Organizations across India trust the Univerzia AI LMS to
                deliver their training programs, corporate learning initiatives, and academic curricula.
            </p>
        </div>
        <div class="about-features-grid">
            <div class="about-feature-card">
                <div class="about-feature-icon"><i class="fa-solid fa-robot"></i></div>
                <h3>AI-Powered Learning</h3>
                <p>Smart course recommendations, automated assessments, and AI tutoring powered by the Univerzia AI engine.</p>
            </div>
            <div class="about-feature-card">
                <div class="about-feature-icon" style="background: #d1fae5;"><i class="fa-solid fa-chart-line"></i></div>
                <h3>Analytics Dashboard</h3>
                <p>Comprehensive learner analytics and performance tracking built into the Univerzia AI LMS platform.</p>
            </div>
            <div class="about-feature-card">
                <div class="about-feature-icon" style="background: #fef3c7;"><i class="fa-solid fa-shield-halved"></i></div>
                <h3>Enterprise Grade</h3>
                <p>Scalable, secure, and reliable infrastructure that powers the Univerzia AI learning ecosystem.</p>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Univerzia AI Section -->
<section class="about-section" style="background: white;">
    <div class="container">
        <div class="about-section-header">
            <div class="section-badge" style="display: inline-block;">Why Us</div>
            <h2>Why Choose <span class="gradient-text">Univerzia AI</span></h2>
        </div>
        <div class="about-content" style="max-width: 900px;">
            <p>
                Choosing Univerzia AI means choosing a partner that combines technical excellence with educational
                expertise. Whether you are a business looking for a reliable technology partner or a student seeking
                career-transforming education, Univerzia AI delivers results that matter.
            </p>
            <ul class="why-choose-list">
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    <span><strong>Real-World Experience:</strong> Univerzia AI students work on actual client projects, gaining hands-on experience that employers value.</span>
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    <span><strong>Expert Mentorship:</strong> Learn from industry veterans who build production-grade solutions at Univerzia AI every day.</span>
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    <span><strong>AI-First Approach:</strong> Univerzia AI integrates artificial intelligence across all its services and learning programs.</span>
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    <span><strong>End-to-End Services:</strong> From web development to digital marketing, Univerzia AI provides comprehensive technology solutions.</span>
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    <span><strong>Trusted by Businesses:</strong> Univerzia AI Pvt Ltd serves clients ranging from startups to established enterprises across India.</span>
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    <span><strong>Career-Focused Training:</strong> Every course at Univerzia AI is designed with job placement and career growth in mind.</span>
                </li>
            </ul>
        </div>
    </div>
</section>

<!-- Dual Identity Section (Agency + Academy) -->
<section class="dual-identity-section">
    <div class="container">
        <div class="about-section-header" style="text-align: center; margin-bottom: 50px;">
            <div class="section-badge" style="display: inline-block;">Two Pillars</div>
            <h2>The Univerzia AI <span class="gradient-text">Ecosystem</span></h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px;">
            <div class="identity-card agency-card">
                <div class="identity-icon"><i class="fa-solid fa-rocket"></i></div>
                <h3>Univerzia AI <span class="gradient-text">Agency</span></h3>
                <p style="color: var(--neutral-600); margin-bottom: 30px;">
                    The Univerzia AI Agency helps businesses scale with cutting-edge technology. Whether you need a world-class website, a powerful LMS, or a full-fledged e-commerce platform, the Univerzia AI team delivers.
                </p>
                <ul style="list-style: none; padding: 0;">
                    <li style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: var(--primary-500);"><i class="fa-solid fa-check"></i></span> Custom Web & App Development
                    </li>
                    <li style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: var(--primary-500);"><i class="fa-solid fa-check"></i></span> LMS & E-Learning Platforms
                    </li>
                    <li style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: var(--primary-500);"><i class="fa-solid fa-check"></i></span> AI Automation & Integration
                    </li>
                    <li style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: var(--primary-500);"><i class="fa-solid fa-check"></i></span> Digital Marketing & SEO
                    </li>
                </ul>
            </div>
            <div class="identity-card academy-card">
                <div class="identity-icon" style="background: #d1fae5;"><i class="fa-solid fa-graduation-cap"></i></div>
                <h3>Univerzia AI <span style="background: linear-gradient(135deg, #10b981, #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Academy</span></h3>
                <p style="color: var(--neutral-600); margin-bottom: 30px;">
                    The Univerzia AI Academy trains the next generation of tech professionals. Hands-on, project-based workshops ensure learners gain skills from real-world projects delivered by Univerzia AI.
                </p>
                <ul style="list-style: none; padding: 0;">
                    <li style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: #10b981;"><i class="fa-solid fa-check"></i></span> AI & Prompt Engineering
                    </li>
                    <li style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: #10b981;"><i class="fa-solid fa-check"></i></span> Data Science & Power BI
                    </li>
                    <li style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: #10b981;"><i class="fa-solid fa-check"></i></span> Python & No-Code Development
                    </li>
                    <li style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
                        <span style="color: #10b981;"><i class="fa-solid fa-check"></i></span> Career Transition Programs
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Bridge Story Section -->
<section class="story-bridge">
    <div class="container">
        <div class="bridge-content">
            <h2 style="font-size: 2.5rem; margin-bottom: 30px;">Why Univerzia AI is Different</h2>
            <p style="color: rgba(255,255,255,0.8); font-size: 1.25rem; line-height: 1.8; margin-bottom: 40px;">
                Unlike traditional agencies or academies, Univerzia AI is a living bridge between industry and education.
                Students at Univerzia AI don't just learn theory — they work on live client projects. Clients of Univerzia AI
                don't just get a product — they get solutions crafted by a team dedicated to continuous learning and innovation.
            </p>
            <div style="display: flex; justify-content: center; gap: 60px; flex-wrap: wrap;">
                {{#bridge_stats}}
                <div>
                    <div style="font-size: 3rem; font-weight: 800; color: {{color}};">{{value}}</div>
                    <div style="color: var(--neutral-400);">{{label}}</div>
                </div>
                {{/bridge_stats}}
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section style="padding: 100px 0;">
    <div class="container">
        <div class="section-header" style="text-align: left; max-width: 100%; margin: 0 0 40px 0;">
            <div class="section-badge" style="display: inline-block;">Meet the Leaders</div>
            <h2 class="section-title">Univerzia AI <span class="gradient-text">Core Team</span></h2>
            <p class="section-subtitle" style="margin-left: 0; max-width: 600px;">
                Industry veterans at Univerzia AI who build enterprise solutions and mentor the next generation of tech professionals.
            </p>
        </div>

        <div class="team-grid">
            {{#team_members}}
            <div class="team-card">
                <div class="team-image-wrapper">
                    <img src="{{image}}" alt="{{name}} - {{role}} at Univerzia AI" class="team-image">
                </div>
                <div class="team-content">
                    <h3>{{name}}</h3>
                    <p class="team-role">{{role}}</p>
                    <p class="team-bio">{{bio}}</p>
                    {{#socials}}
                    <div class="team-socials">
                        <a href="#" aria-label="LinkedIn profile"><i class="fa-brands fa-linkedin"></i></a>
                        <a href="#" aria-label="Twitter profile"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
                    </div>
                    {{/socials}}
                </div>
            </div>
            {{/team_members}}
        </div>
    </div>
</section>

<style>
/* Team Section Styles */
.team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
    margin-top: 60px;
}

.team-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    border: 1px solid rgba(0,0,0,0.05);
    text-align: center;
    padding: 40px 30px;
}

.team-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    border-color: var(--primary-200);
}

.team-image-wrapper {
    width: 120px;
    height: 120px;
    margin: 0 auto 25px;
    position: relative;
}

.team-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--neutral-50);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
}

.team-content h3 {
    color: var(--neutral-900);
    margin-bottom: 5px;
    font-size: 1.25rem;
}

.team-role {
    color: var(--primary-600);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.team-bio {
    color: var(--neutral-600);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 25px;
}

.team-socials {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.team-socials a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--neutral-100);
    color: var(--neutral-600);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    text-decoration: none;
}

.team-socials a:hover {
    background: var(--primary-600);
    color: white;
    transform: translateY(-3px);
}
</style>

<!-- CTA Section -->
<section style="padding-bottom: 100px;">
    <div class="container">
        <div class="cta-box" style="background: linear-gradient(135deg, var(--primary-600), var(--primary-500)); border-radius: 24px; padding: 60px; text-align: center; color: white;">
            <h2 style="color: white; margin-bottom: 20px;">Join the Univerzia AI Journey</h2>
            <p style="color: rgba(255,255,255,0.9); margin-bottom: 30px; font-size: 1.2rem;">
                Whether you want to hire Univerzia AI for your next project or join the Univerzia AI Academy to transform your career, we'd love to connect.
            </p>
            <div style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
                <a href="{{{page_contact}}}" class="btn-secondary btn-large" style="background: white; color: var(--primary-600);">Get in Touch</a>
                <a href="{{{page_courses}}}" class="btn-primary btn-large" style="background: rgba(255,255,255,0.2); color: white; border: 2px solid white;">Explore Courses</a>
            </div>
        </div>
    </div>
</section>

{{> local_univerziaai/footer }}
