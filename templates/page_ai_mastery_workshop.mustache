{{!
    AI Mastery Workshop - Complete 6-Phase AI Training Page
}}
{{> local_univerziaai/navbar }}

<!-- Hero Section -->
<section class="amw-hero">
    <div class="container">
        <div class="amw-hero-badge">
            <i class="fa-solid fa-rocket"></i> {{hero_badge}}
        </div>
        <h1>{{{hero_title}}}</h1>
        <p class="amw-hero-subtitle">{{hero_subtitle}}</p>

        <div class="amw-hero-stats">
            {{#hero_stats}}
            <div class="amw-stat">
                <div class="amw-stat-value">{{value}}</div>
                <div class="amw-stat-label">{{label}}</div>
            </div>
            {{/hero_stats}}
        </div>

        <div class="amw-hero-cta">
            <a href="#amw-register" class="amw-btn-primary" data-scroll-to="#amw-register">
                <i class="fa-solid fa-paper-plane"></i> Enroll Now
            </a>
            <a href="#amw-curriculum" class="amw-btn-secondary" data-scroll-to="#amw-curriculum">
                <i class="fa-solid fa-list-check"></i> View Curriculum
            </a>
        </div>
    </div>
</section>

<!-- Curriculum Section -->
<section class="amw-curriculum" id="amw-curriculum">
    <div class="container">
        <div class="amw-section-header-center">
            <div class="amw-section-badge"><i class="fa-solid fa-book-open"></i> Curriculum</div>
            <h2 class="amw-section-title">6-Phase Learning <span class="amw-gradient-text">Journey</span></h2>
            <p class="amw-section-subtitle">From AI fundamentals to real-world deployment — each phase builds on the last to give you complete mastery.</p>
        </div>

        <div class="amw-timeline">
            {{#phases}}
            <div class="amw-phase{{#is_first}} amw-phase--open{{/is_first}}">
                <div class="amw-phase-dot" style="background: {{color}};">{{number}}</div>
                <div class="amw-phase-card">
                    <div class="amw-phase-header">
                        <div class="amw-phase-header-left">
                            <div class="amw-phase-icon" style="background: {{color}};">{{{icon}}}</div>
                            <div class="amw-phase-info">
                                <h3>Phase {{number}}: {{title}}</h3>
                                <p>{{subtitle}}</p>
                            </div>
                        </div>
                        <div class="amw-phase-toggle">
                            <i class="fa-solid fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="amw-phase-body">
                        <div class="amw-topics-list">
                            {{#topics}}
                            <div class="amw-topic">
                                <div class="amw-topic-icon">{{{icon}}}</div>
                                <span class="amw-topic-name">{{name}}</span>
                            </div>
                            {{/topics}}
                        </div>
                    </div>
                </div>
            </div>
            {{/phases}}
        </div>
    </div>
</section>

<!-- Highlights Section -->
<section class="amw-highlights">
    <div class="container">
        <div class="amw-section-header-center">
            <div class="amw-section-badge"><i class="fa-solid fa-star"></i> Why Choose Us</div>
            <h2 class="amw-section-title">Program <span class="amw-gradient-text">Highlights</span></h2>
            <p class="amw-section-subtitle">Everything you need to succeed in your AI career, all in one comprehensive program.</p>
        </div>

        <div class="amw-highlights-grid">
            {{#highlights}}
            <div class="amw-highlight-card">
                <div class="amw-highlight-icon">{{{icon}}}</div>
                <h3>{{title}}</h3>
                <p>{{description}}</p>
            </div>
            {{/highlights}}
        </div>
    </div>
</section>

<!-- Target Audience Section -->
<section class="amw-audience">
    <div class="container">
        <div class="amw-section-header-center">
            <div class="amw-section-badge"><i class="fa-solid fa-users"></i> Who Is This For</div>
            <h2 class="amw-section-title">Perfect For <span class="amw-gradient-text">You</span></h2>
            <p class="amw-section-subtitle">Whether you're just starting or looking to level up, this program is designed for every learner.</p>
        </div>

        <div class="amw-audience-grid">
            {{#target_audience}}
            <div class="amw-audience-card">
                <div class="amw-audience-icon">{{{icon}}}</div>
                <h3>{{title}}</h3>
                <p>{{description}}</p>
            </div>
            {{/target_audience}}
        </div>
    </div>
</section>

<!-- Registration Section -->
<section class="amw-register" id="amw-register">
    <div class="container">
        <div class="amw-register-layout">
            <div class="amw-register-info">
                <div class="amw-section-badge" style="background: rgba(240,128,66,0.15); border: 1px solid rgba(240,128,66,0.3);"><i class="fa-solid fa-pen-to-square"></i> Register Now</div>
                <h2>Start Your <span class="amw-gradient-text">AI Journey</span> Today</h2>
                <p>Fill out the form and our team will get in touch with you with complete workshop details, schedule, and pricing.</p>
                <div class="amw-register-features">
                    <div class="amw-register-feature">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>No prior AI or coding experience required</span>
                    </div>
                    <div class="amw-register-feature">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>Flexible batch timings — weekday & weekend</span>
                    </div>
                    <div class="amw-register-feature">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>Lifetime access to course materials & community</span>
                    </div>
                    <div class="amw-register-feature">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>Industry-recognized certification on completion</span>
                    </div>
                </div>
            </div>
            <div class="amw-form-card">
                <h3><i class="fa-solid fa-user-plus"></i> Enquire Now</h3>
                <form id="amwRegForm" data-action="{{{form_action_url}}}">
                    <div class="amw-form-row">
                        <div class="amw-form-group">
                            <label for="amwFirstName">First Name *</label>
                            <input type="text" id="amwFirstName" name="firstname" placeholder="Your first name" required>
                        </div>
                        <div class="amw-form-group">
                            <label for="amwLastName">Last Name *</label>
                            <input type="text" id="amwLastName" name="lastname" placeholder="Your last name" required>
                        </div>
                    </div>
                    <div class="amw-form-row">
                        <div class="amw-form-group">
                            <label for="amwEmail">Email Address *</label>
                            <input type="email" id="amwEmail" name="email" placeholder="you@example.com" required>
                        </div>
                        <div class="amw-form-group">
                            <label for="amwPhone">Phone Number</label>
                            <input type="tel" id="amwPhone" name="phone" placeholder="+91 XXXXX XXXXX">
                        </div>
                    </div>
                    <div class="amw-form-group">
                        <label for="amwMessage">Message (Optional)</label>
                        <textarea id="amwMessage" name="message" rows="3" placeholder="Any questions or special requirements..."></textarea>
                    </div>
                    <button type="submit" class="amw-form-submit">
                        <i class="fa-solid fa-paper-plane"></i> Submit Enquiry
                    </button>
                    <div id="amwFormMessage" class="amw-form-message"></div>
                </form>
            </div>
        </div>
    </div>
</section>

{{> local_univerziaai/footer }}
