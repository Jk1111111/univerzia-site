{{!
    Contact page template for UniverziaAi
}}
{{> local_univerziaai/navbar }}

<!-- Contact Hero -->
<section class="page-hero" style="padding-top: 160px; padding-bottom: 80px; background: linear-gradient(135deg, #fff5f0 0%, #ffffff 100%);">
    <div class="container">
        <div style="text-align: center;">
            <div class="badge">Get In Touch</div>
            <h1 class="hero-title">Let's Start a <span class="gradient-text">Conversation</span></h1>
            <p class="hero-subtitle" style="max-width: 600px; margin: 0 auto;">
                Have a project in mind or want to join our academy? We'd love to hear from you.
            </p>
        </div>
    </div>
</section>

<!-- Registration Form Section (Same as Home) -->
<section style="padding: 80px 0;">
    <div class="container">
        <div class="registration-wrapper">
            <!-- Left Side: Form -->
            <div class="registration-form-container" id="registrationFormContainer">
                <div class="form-header">
                    <span class="form-badge">Registration Form</span>
                    <p class="form-instruction">Please fill in the form carefully and make sure all information is accurate*</p>
                </div>
                
                <form id="admissionForm" class="admission-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="firstName">First Name</label>
                            <input type="text" id="firstName" name="firstname" required>
                        </div>
                        <div class="form-group">
                            <label for="lastName">Last Name</label>
                            <input type="text" id="lastName" name="lastname" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" required>
                        </div>
                        <div class="form-group">
                            <label for="phone">Phone</label>
                            <input type="tel" id="phone" name="phone">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="country">Country</label>
                        <input type="text" id="country" name="country" placeholder="Country">
                    </div>
                    
                    <div class="form-group">
                        <label>Select Department</label>
                        <div class="department-options">
                            <label class="radio-container">Academic
                                <input type="radio" name="department" value="Academic" checked>
                                <span class="checkmark"></span>
                            </label>
                            <label class="radio-container">Services
                                <input type="radio" name="department" value="Services">
                                <span class="checkmark"></span>
                            </label>
                        </div>
                    </div>
                    
                    <!-- Dynamic Dropdown Container -->
                    <div class="form-group" id="courseServiceContainer">
                        <label id="dropdownLabel">Select Course</label>
                        <select id="courseServiceSelect" name="course_service" required>
                            <option value="">Select Option</option>
                            {{#admission_form_options.academic}}
                            <option value="{{.}}">{{.}}</option>
                            {{/admission_form_options.academic}}
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="message">Message (Optional)</label>
                        <textarea id="message" name="message" rows="3" placeholder="Any specific requirements?"></textarea>
                    </div>
                    
                    <button type="submit" class="apply-btn">
                        <i class="fa-solid fa-paper-plane"></i> Apply Now
                    </button>
                    
                    <div id="formMessage" class="form-message"></div>
                </form>
            </div>

            <!-- Success State (Hidden by default) -->
            <div class="registration-success-container" id="registrationSuccessContainer" style="display: none; padding: 60px; text-align: center; flex: 1; flex-direction: column; justify-content: center; align-items: center;">
                <div style="width: 80px; height: 80px; background: #d1fae5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
                    <i class="fa-solid fa-check" style="font-size: 40px; color: #10b981;"></i>
                </div>
                <h3 style="font-size: 2rem; color: #1a2a3a; margin-bottom: 16px;">Registration Successful!</h3>
                <p style="color: #64748b; font-size: 1.1rem; max-width: 400px; margin: 0 auto 30px;">Thank you for registering. We have received your details and will contact you shortly.</p>
                <button id="registerAnotherBtn" class="apply-btn" style="max-width: 250px;">Register Another</button>
            </div>
            
            <!-- Right Side: Contact Info & Map (Replaced Image) -->
            <div class="registration-image-container" style="background: var(--neutral-50); padding: 40px; display: flex; flex-direction: column; gap: 30px;">
                <!-- Contact Details -->
                <div style="background: var(--neutral-900); color: white; padding: 30px; border-radius: 20px;" itemscope itemtype="https://schema.org/LocalBusiness">
                    <h3 style="color: white; margin-bottom: 6px;" itemprop="name">Univerzia AI Private Limited</h3>
                    <p style="color: var(--neutral-400); font-size: 0.85rem; margin-bottom: 20px;">Contact Information</p>
                    <div style="margin-bottom: 20px;">
                        <div style="color: var(--primary-400); font-weight: 600; margin-bottom: 5px;"><i class="fa-solid fa-envelope"></i> Email</div>
                        <a href="mailto:{{contact_info.email}}" class="contact-link" style="color: white;" itemprop="email">{{contact_info.email}}</a>
                    </div>
                    
                    <div style="margin-bottom: 20px;">
                        <div style="color: var(--primary-400); font-weight: 600; margin-bottom: 5px;"><i class="fa-solid fa-phone"></i> Phone</div>
                        <a href="tel:{{contact_info.phone}}" class="contact-link" style="color: white;" itemprop="telephone">{{contact_info.phone}}</a>
                        <div style="font-size: 0.85em; color: var(--neutral-400); margin-top: 5px;">{{contact_info.phone_hours}}</div>
                    </div>
                    
                    <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                        <div style="color: var(--primary-400); font-weight: 600; margin-bottom: 5px;"><i class="fa-solid fa-location-dot"></i> Location</div>
                        <div class="contact-text" style="color: var(--neutral-200);"><span itemprop="streetAddress">{{contact_info.address_line1}}</span><br><span itemprop="addressLocality">{{contact_info.address_line2}}</span>, <span itemprop="addressRegion">{{contact_info.address_line3}}</span></div>
                    </div>
                </div>

                <!-- Google Map Embed -->
                 <div style="flex: 1; border-radius: 20px; overflow: hidden; min-height: 250px;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3607.0!2d82.987!3d25.327!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x398e2e0000000000%3A0x0!2sAwas+Vikas+Colony%2C+Pandeypur%2C+Varanasi%2C+Uttar+Pradesh+221002!5e0!3m2!1sen!2sin" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
/* Reusing Registration CSS from Home Page */
.registration-wrapper {
    display: flex;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.05);
}

.registration-form-container {
    flex: 6; /* Slightly wider form */
    padding: 60px;
}

.registration-image-container {
    flex: 4; /* Narrower sidebar */
}

.form-header {
    margin-bottom: 40px;
}

.form-badge {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid #10b981;
    color: #10b981;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
    background: rgba(16, 185, 129, 0.05);
    border-radius: 4px;
}

.form-instruction {
    font-size: 0.9rem;
    color: #64748b;
    font-style: italic;
}

.admission-form .form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
}

.admission-form .form-group {
    flex: 1;
    margin-bottom: 20px;
}

.admission-form label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1a2a3a;
    margin-bottom: 8px;
}

.admission-form input[type="text"],
.admission-form input[type="email"],
.admission-form input[type="tel"],
.admission-form select,
.admission-form textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #334155;
    transition: all 0.3s ease;
    background: #f8fafc;
}

.admission-form input:focus,
.admission-form select:focus,
.admission-form textarea:focus {
    outline: none;
    border-color: #1a2a3a;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(26, 42, 58, 0.1);
}

/* Radio Button Styles */
.department-options {
    display: flex;
    gap: 30px;
    margin-top: 10px;
}

.radio-container {
    display: block;
    position: relative;
    padding-left: 35px;
    margin-bottom: 12px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
    color: #334155;
    user-select: none;
}

.radio-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
}

.checkmark {
    position: absolute;
    top: 0;
    left: 0;
    height: 22px;
    width: 22px;
    background-color: #f1f5f9;
    border: 2px solid #cbd5e1;
    border-radius: 50%;
    transition: all 0.2s ease;
}

.radio-container:hover input ~ .checkmark {
    background-color: #e2e8f0;
}

.radio-container input:checked ~ .checkmark {
    background-color: #1a2a3a;
    border-color: #1a2a3a;
}

.checkmark:after {
    content: "";
    position: absolute;
    display: none;
}

.radio-container input:checked ~ .checkmark:after {
    display: block;
}

.radio-container .checkmark:after {
    top: 6px;
    left: 6px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
}
/* End Radio Styles */

.apply-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 32px;
    background: #1a2a3a; 
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    margin-top: 10px;
}

.apply-btn:hover {
    background: #2d4a5e;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}

.form-message {
    margin-top: 20px;
    font-size: 0.95rem;
    text-align: center;
    min-height: 20px;
}

.form-message.success { color: #10b981; }
.form-message.error { color: #ef4444; }

/* Responsive Registration */
@media (max-width: 1024px) {
    .registration-wrapper {
        flex-direction: column;
    }
    
    .registration-form-container {
        padding: 40px;
    }
    
    .registration-image-container {
        min-height: auto;
        order: 1; /* keep contact info below form on mobile */
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const departmentRadios = document.querySelectorAll('input[name="department"]');
    const dropdownLabel = document.getElementById('dropdownLabel');
    const courseServiceSelect = document.getElementById('courseServiceSelect');
    
    // Data from Mustache
    const academicOptions = [
        {{#admission_form_options.academic}}
        "{{.}}",
        {{/admission_form_options.academic}}
    ];
    
    const serviceOptions = [
        {{#admission_form_options.services}}
        "{{.}}",
        {{/admission_form_options.services}}
    ];
    
    function updateDropdown(dept) {
        // Clear existing
        courseServiceSelect.innerHTML = '<option value="">Select Option</option>';
        
        let options = [];
        if (dept === 'Academic') {
            dropdownLabel.textContent = 'Select Course';
            options = academicOptions;
        } else {
            dropdownLabel.textContent = 'Select Service';
            options = serviceOptions;
        }
        
        options.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt;
            option.textContent = opt;
            courseServiceSelect.appendChild(option);
        });
    }
    
    departmentRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
            updateDropdown(e.target.value);
        });
    });
    
    // Form Submission
    const form = document.getElementById('admissionForm');
    const messageDiv = document.getElementById('formMessage');
    const submitBtn = form.querySelector('.apply-btn');
    const formContainer = document.getElementById('registrationFormContainer');
    const successContainer = document.getElementById('registrationSuccessContainer');
    const registerAnotherBtn = document.getElementById('registerAnotherBtn');
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
        messageDiv.textContent = '';
        messageDiv.className = 'form-message';
        
        const formData = new FormData(form);
        
        fetch('{{{pluginurl}}}/ajax_submit_admission.php', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Show success container
                formContainer.style.display = 'none';
                successContainer.style.display = 'flex';
                
                form.reset();
                updateDropdown('Academic');
            } else {
                messageDiv.textContent = data.message || 'An error occurred.';
                messageDiv.classList.add('error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            messageDiv.textContent = 'Network error. Please try again.';
            messageDiv.classList.add('error');
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Apply Now';
        });
    });
    
    if (registerAnotherBtn) {
        registerAnotherBtn.addEventListener('click', function() {
            successContainer.style.display = 'none';
            formContainer.style.display = 'block';
            messageDiv.textContent = '';
        });
    }
});
</script>

<!-- FAQ Section -->
<section style="padding: 80px 0; background: var(--neutral-100);">
    <div class="container">
        <div class="section-header-center">
            <h2 class="section-title">Frequently Asked <span class="gradient-text">Questions</span></h2>
        </div>
        <div style="max-width: 800px; margin: 0 auto;">
            {{#faq_items}}
            <div class="faq-item">
                <div class="faq-question">
                    <h4>{{question}}</h4>
                    <span class="faq-toggle">+</span>
                </div>
                <div class="faq-answer">
                    <p>{{answer}}</p>
                </div>
            </div>
            {{/faq_items}}
        </div>
    </div>
</section>

<!-- Status Modal -->
<div id="statusModal" class="custom-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
    <div class="modal-content" style="background: white; width: 90%; max-width: 400px; padding: 30px; border-radius: 20px; text-align: center; animation: slideUp 0.3s ease-out;">
        <div style="font-size: 3rem; margin-bottom: 20px;">
            {{#form_success}}<i class="fa-solid fa-circle-check"></i>{{/form_success}}{{^form_success}}<i class="fa-solid fa-triangle-exclamation"></i>{{/form_success}}
        </div>
        <h3 style="margin-bottom: 10px; color: var(--neutral-900);">
            {{#form_success}}Success!{{/form_success}}{{^form_success}}Attention{{/form_success}}
        </h3>
        <p style="color: var(--neutral-600); margin-bottom: 25px; line-height: 1.6;">{{form_message}}</p>
        <button onclick="closeStatusModal()" class="btn-primary" style="padding: 10px 30px; border-radius: 50px; border: none; cursor: pointer;">OK</button>
    </div>
</div>

<script>
    const statusModal = document.getElementById('statusModal');
    
    function closeStatusModal() {
        statusModal.style.display = 'none';
        // Remove query params to prevent modal showing on refresh
        if (history.pushState) {
            var newurl = window.location.protocol + "//" + window.location.host + window.location.pathname;
            window.history.pushState({path:newurl},'',newurl);
        }
    }

    {{#form_message}}
    statusModal.style.display = 'flex';
    {{/form_message}}

    // Close on outside click
    window.onclick = function(event) {
        if (event.target == statusModal) {
            closeStatusModal();
        }
    }
</script>

{{> local_univerziaai/footer }}
