    color: #64748b;
    line-height: 1.6;
    margin: 0;
}

/* Benefits Responsive */
@media (max-width: 1024px) {
    .benefits-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .benefits-header-wrapper {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }
}


.benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: stretch;
}

.benefits-slider-container {
    grid-column: span 3;
    overflow: hidden;
    position: relative;
}

.slider-window {
    width: 100%;
    overflow: hidden;
}

.benefits-track {
    display: flex;
    gap: 24px; /* Matches grid gap */
    width: 100%;
    /* Transition is handled by JS */
}

.slide-item {
    /* Width calculation: (100% - (2 * gap)) / 3 items */
    /* But since we use gap in flex, calculating exact width */
    flex: 0 0 calc((100% - 48px) / 3);
    width: calc((100% - 48px) / 3);
}

/* Responsive Slider */
@media (max-width: 1024px) {
    .benefits-grid {
        grid-template-columns: 1fr;
    }
    
    .benefits-slider-container {
        grid-column: auto;
        width: 100%;
    }
    
    /* Show 2 items on tablet? Or keep stacking behavior */
    .slide-item {
        flex: 0 0 calc((100% - 24px) / 2);
    }
}

@media (max-width: 768px) {
    .benefits-section {
        padding: 60px 0;
    }

    .slide-item {
        flex: 0 0 100%;
    }
    
    /* Update JS logic for mobile via JS or just CSS stack? */
    /* To keep slider working, we need JS to know visible items */
    /* For now assuming slider keeps working but shows 1 item */

    
    .benefits-title {
        font-size: 2rem;
    }
    
    .nav-card {
        padding: 24px;
        order: -1; 
        /* keeps controls at top or move to bottom if preferred */
    }
}


