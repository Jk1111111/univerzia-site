{{!
    Courses page template for UniverziaAi - Redesigned
}}
{{> local_univerziaai/navbar }}

<!-- Learning Hub / Courses Section -->
<section id="courses" class="cx-section">
    <div class="container">
        <!-- Section Header -->
        <div class="cx-header">
            <span class="cx-badge"><i class="fa-solid fa-graduation-cap"></i> Our Programs</span>
            <h2 class="cx-title">Explore Our Most Popular <span class="cx-title-accent">Courses</span></h2>
            <p class="cx-subtitle">Industry-aligned programs designed by experts. Gain job-ready skills in AI, Data Science, and cutting-edge technology with hands-on, project-based learning.</p>
        </div>

        <!-- Category Tabs -->
        <div class="cx-tabs-wrap">
            {{#category_tabs}}
            <button class="cx-tab {{#active}}cx-tab--active{{/active}}" data-category="{{category}}">
                {{#icon}}<span class="cx-tab-icon">{{{icon}}}</span>{{/icon}}
                <span>{{label}}</span>
            </button>
            {{/category_tabs}}
        </div>

        <!-- === PANEL: AI Workshops === -->
        <div class="cx-panel cx-panel--active" id="panel-ai-workshops">
            <div class="cx-spotlight">
                <div class="cx-spotlight-left">
                    <div class="cx-spotlight-badge"><i class="fa-solid fa-bullseye"></i> AI Workshops</div>
                    <h3 class="cx-spotlight-title">Master AI Tools & Prompt Engineering</h3>
                    <p class="cx-spotlight-desc">{{ai_workshops_content.description}}</p>
                    <a href="{{{page_ai_workshops}}}" class="cx-btn-primary"><span>Explore Workshop</span> <i class="fa-solid fa-arrow-right"></i></a>
                </div>
                <div class="cx-spotlight-right">
                    <div class="cx-outcomes-list">
                        {{#ai_workshops_content.outcomes}}
                        <div class="cx-outcome-item">
                            <span class="cx-outcome-check"><i class="fa-solid fa-check"></i></span>
                            <span>{{.}}</span>
                        </div>
                        {{/ai_workshops_content.outcomes}}
                    </div>
                    <div class="cx-spotlight-stats">
                        <div class="cx-stat-chip"><i class="fa-solid fa-clock"></i> 3+ Hours Live</div>
                        <div class="cx-stat-chip"><i class="fa-solid fa-certificate"></i> Certificate</div>
                        <div class="cx-stat-chip"><i class="fa-solid fa-indian-rupee-sign"></i> Just ₹9</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- === PANEL: AI Mastery === -->
        <div class="cx-panel" id="panel-ai-mastery">
            <div class="cx-spotlight">
                <div class="cx-spotlight-left">
                    <div class="cx-spotlight-badge"><i class="fa-solid fa-rocket"></i> AI Mastery</div>
                    <h3 class="cx-spotlight-title">Complete AI Toolkit for Your Career</h3>
                    <p class="cx-spotlight-desc">{{ai_mastery_content.description}}</p>
                    <a href="{{{page_ai_mastery_workshop}}}" class="cx-btn-primary"><span>View All AI Courses</span> <i class="fa-solid fa-arrow-right"></i></a>
                </div>
                <div class="cx-spotlight-right">
                    <div class="cx-outcomes-list">
                        {{#ai_mastery_content.key_points}}
                        <div class="cx-outcome-item">
                            <span class="cx-outcome-check"><i class="fa-solid fa-bolt"></i></span>
                            <span>{{.}}</span>
                        </div>
                        {{/ai_mastery_content.key_points}}
                    </div>
                </div>
            </div>

        </div>

        <!-- === PANEL: Tech Program === -->
        <div class="cx-panel" id="panel-tech">
            <div class="cx-spotlight cx-spotlight--compact">
                <div class="cx-spotlight-left">
                    <div class="cx-spotlight-badge"><i class="fa-solid fa-laptop-code"></i> Tech Program</div>
                    <h3 class="cx-spotlight-title">Build, Code & Automate with AI</h3>
                    <p class="cx-spotlight-desc">{{tech_program_content.description}}</p>
                </div>
            </div>
            <div class="cx-cards-grid">
                {{#tech_program_content.courses}}
                <div class="cx-card cx-card--tech">
                    <div class="cx-card-icon-wrap">{{{icon}}}</div>
                    <h4 class="cx-card-title">{{title}}</h4>
                    <span class="cx-card-duration"><i class="fa-regular fa-clock"></i> {{duration}}</span>
                    <p class="cx-card-desc">{{description}}</p>
                    <button class="cx-card-btn" onclick="openCourseModal('{{modal_id}}')" style="background:none; border:none; cursor:pointer; padding:0; font-family:inherit;">Learn More <i class="fa-solid fa-arrow-right"></i></button>
                </div>
                
                <!-- Course Modal (Moved outside card to avoid transform issues) -->
                <div class="course-modal-overlay" id="{{modal_id}}">
                    <div class="course-modal">
                        <button class="course-modal-close" onclick="closeCourseModal('{{modal_id}}')">&times;</button>
                        <div class="course-modal-header">
                            <div class="course-modal-icon">{{{icon}}}</div>
                            <div>
                                <h3 class="course-modal-title">{{title}}</h3>
                                <span class="course-modal-duration"><i class="fa-regular fa-clock"></i> {{duration}}</span>
                            </div>
                        </div>
                        <div class="course-modal-body">
                            <h4 class="course-curriculum-title">Course Curriculum</h4>
                            <div class="amw-timeline" style="margin: 0; padding-left: 0;">
                                {{#curriculum}}
                                <div class="amw-phase">
                                    <div class="amw-phase-dot" style="background: {{color}};">{{number}}</div>
                                    <div class="amw-phase-card">
                                        <div class="amw-phase-header" onclick="togglePhase(this)">
                                            <div class="amw-phase-header-left">
                                                <div class="amw-phase-info">
                                                    <h3 style="font-size: 1rem; margin:0;">Phase {{number}}: {{title}}</h3>
                                                </div>
                                            </div>
                                            <div class="amw-phase-toggle">
                                                <i class="fa-solid fa-chevron-down"></i>
                                            </div>
                                        </div>
                                        <div class="amw-phase-body">
                                            <div class="amw-topics-list">
                                                {{#topics}}
                                                <div class="amw-topic" style="padding: 8px 12px;">
                                                    <div class="amw-topic-icon" style="width: 24px; height: 24px; font-size: 0.7rem; color: {{color}};">
                                                        <i class="fa-solid fa-check"></i>
                                                    </div>
                                                    <span class="amw-topic-name" style="font-size: 0.9rem;">{{.}}</span>
                                                </div>
                                                {{/topics}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {{/curriculum}}
                            </div>
                        </div>
                        <div class="course-modal-footer">
                            <a href="{{{page_contact}}}" class="cx-btn-primary" style="width: 100%; justify-content: center;">Enroll Now</a>
                        </div>
                    </div>
                </div>
                {{/tech_program_content.courses}}
            </div>
        </div>

        <!-- === PANEL: Data Program === -->
        <div class="cx-panel" id="panel-data">
            <div class="cx-spotlight cx-spotlight--compact">
                <div class="cx-spotlight-left">
                    <div class="cx-spotlight-badge"><i class="fa-solid fa-chart-simple"></i> Data Program</div>
                    <h3 class="cx-spotlight-title">Turn Data into Actionable Insights</h3>
                    <p class="cx-spotlight-desc">{{data_program_content.description}}</p>
                </div>
            </div>
            <div class="cx-cards-grid">
                {{#data_program_content.courses}}
                <div class="cx-card cx-card--data">
                    <div class="cx-card-icon-wrap">{{{icon}}}</div>
                    <h4 class="cx-card-title">{{title}}</h4>
                    <span class="cx-card-duration"><i class="fa-regular fa-clock"></i> {{duration}}</span>
                    <p class="cx-card-desc">{{description}}</p>
                    <button class="cx-card-btn" onclick="openCourseModal('{{modal_id}}')" style="background:none; border:none; cursor:pointer; padding:0; font-family:inherit;">Learn More <i class="fa-solid fa-arrow-right"></i></button>
                </div>

                <!-- Course Modal -->
                <div class="course-modal-overlay" id="{{modal_id}}">
                    <div class="course-modal">
                        <button class="course-modal-close" onclick="closeCourseModal('{{modal_id}}')">&times;</button>
                        <div class="course-modal-header">
                            <div class="course-modal-icon">{{{icon}}}</div>
                            <div>
                                <h3 class="course-modal-title">{{title}}</h3>
                                <span class="course-modal-duration"><i class="fa-regular fa-clock"></i> {{duration}}</span>
                            </div>
                        </div>
                        <div class="course-modal-body">
                            <h4 class="course-curriculum-title">Course Curriculum</h4>
                            <div class="amw-timeline" style="margin: 0; padding-left: 0;">
                                {{#curriculum}}
                                <div class="amw-phase">
                                    <div class="amw-phase-dot" style="background: {{color}};">{{number}}</div>
                                    <div class="amw-phase-card">
                                        <div class="amw-phase-header" onclick="togglePhase(this)">
                                            <div class="amw-phase-header-left">
                                                <div class="amw-phase-info">
                                                    <h3 style="font-size: 1rem; margin:0;">Phase {{number}}: {{title}}</h3>
                                                </div>
                                            </div>
                                            <div class="amw-phase-toggle">
                                                <i class="fa-solid fa-chevron-down"></i>
                                            </div>
                                        </div>
                                        <div class="amw-phase-body">
                                            <div class="amw-topics-list">
                                                {{#topics}}
                                                <div class="amw-topic" style="padding: 8px 12px;">
                                                    <div class="amw-topic-icon" style="width: 24px; height: 24px; font-size: 0.7rem; color: {{color}};">
                                                        <i class="fa-solid fa-check"></i>
                                                    </div>
                                                    <span class="amw-topic-name" style="font-size: 0.9rem;">{{.}}</span>
                                                </div>
                                                {{/topics}}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {{/curriculum}}
                            </div>
                        </div>
                        <div class="course-modal-footer">
                            <a href="{{{page_contact}}}" class="cx-btn-primary" style="width: 100%; justify-content: center;">Enroll Now</a>
                        </div>
                    </div>
                </div>
                {{/data_program_content.courses}}
            </div>
        </div>

        <!-- Bottom CTA -->
        <div class="cx-bottom-cta">
            <p>Can't decide? Talk to our learning advisor.</p>
            <a href="{{{page_contact}}}" class="cx-btn-outline">Get Free Counselling <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    </div>
</section>

<!-- Registration/Enquiry Section -->
<section class="cx-register" id="cx-register">
    <div class="cx-container">
        <div class="cx-register-layout">
            <div class="cx-register-info">
                <div class="cx-section-badge"><i class="fa-solid fa-pen-to-square"></i> Register Now</div>
                <h2>Start Your <span class="cx-gradient-text">AI Journey</span> Today</h2>
                <p>Fill out the form and our team will get in touch with you with complete workshop details, schedule, and pricing.</p>
                
                <div class="cx-register-features">
                    <div class="cx-register-feature">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>No prior AI or coding experience required</span>
                    </div>
                    <div class="cx-register-feature">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>Flexible batch timings — weekday & weekend</span>
                    </div>
                    <div class="cx-register-feature">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>Lifetime access to course materials & community</span>
                    </div>
                    <div class="cx-register-feature">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>Industry-recognized certification on completion</span>
                    </div>
                </div>
            </div>

            <div class="cx-form-card">
                <h3><i class="fa-solid fa-user-plus"></i> Enquire Now</h3>
                
                <form id="cxRegForm" data-action="{{{form_action_url}}}">
                    <!-- Hidden fields for backend validation -->
                    <input type="hidden" name="department" value="Academic">
                    <input type="hidden" name="course_service" value="General Course Inquiry">

                    <div class="cx-form-row">
                        <div class="cx-form-group">
                            <label for="cxFirstName">First Name *</label>
                            <input type="text" id="cxFirstName" name="firstname" placeholder="Your first name" required>
                        </div>
                        <div class="cx-form-group">
                            <label for="cxLastName">Last Name *</label>
                            <input type="text" id="cxLastName" name="lastname" placeholder="Your last name" required>
                        </div>
                    </div>
                    <div class="cx-form-row">
                        <div class="cx-form-group">
                            <label for="cxEmail">Email Address *</label>
                            <input type="email" id="cxEmail" name="email" placeholder="you@example.com" required>
                        </div>
                        <div class="cx-form-group">
                            <label for="cxPhone">Phone Number</label>
                            <input type="tel" id="cxPhone" name="phone" placeholder="+91 XXXXX XXXXX">
                        </div>
                    </div>
                    <div class="cx-form-group">
                        <label for="cxMessage">Message (Optional)</label>
                        <textarea id="cxMessage" name="message" rows="3" placeholder="Any questions or special requirements..."></textarea>
                    </div>
                    
                    <button type="submit" class="cx-form-submit">
                        <i class="fa-solid fa-paper-plane"></i> Submit Enquiry
                    </button>
                    
                    <div id="cxFormMessage" class="cx-form-message"></div>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
/* Registration Section Styles (Dark Theme) */
.cx-register {
    padding: 100px 0;
    background: linear-gradient(135deg, #0f0c29 0%, #1a1a2e 50%, #16213e 100%);
    color: #fff;
    position: relative;
    overflow: hidden;
}

.cx-register::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -15%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(240,128,66,0.1) 0%, transparent 70%);
    border-radius: 50%;
}

.cx-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

.cx-register-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
}

.cx-section-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(240,128,66,0.15);
    border: 1px solid rgba(240,128,66,0.3);
    color: #F08042;
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 24px;
}

.cx-register-info h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 16px;
    line-height: 1.2;
}

.cx-gradient-text {
    background: linear-gradient(135deg, #F08042, #E8652B);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.cx-register-info p {
    color: rgba(255,255,255,0.7);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 32px;
}

.cx-register-features {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.cx-register-feature {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
}

.cx-register-feature i {
    color: #F08042;
    font-size: 1.1rem;
    flex-shrink: 0;
}

.cx-register-feature span {
    color: rgba(255,255,255,0.85);
    font-size: 0.95rem;
    font-weight: 500;
}

.cx-form-card {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 36px;
}

.cx-form-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.cx-form-card h3 i { color: #F08042; }

.cx-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
}

.cx-form-group {
    margin-bottom: 16px;
}

.cx-form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    margin-bottom: 6px;
}

.cx-form-group input,
.cx-form-group textarea {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 10px;
    color: #fff;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    font-family: inherit;
}

.cx-form-group input::placeholder,
.cx-form-group textarea::placeholder {
    color: rgba(255,255,255,0.4);
}

.cx-form-group input:focus,
.cx-form-group textarea:focus {
    outline: none;
    border-color: #F08042;
    background: rgba(255,255,255,0.12);
    box-shadow: none;
}

.cx-form-submit {
    width: 100%;
    padding: 14px;
    background: linear-gradient(135deg, #F08042, #E8652B);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.cx-form-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(240,128,66,0.4);
}

.cx-form-message {
    text-align: center;
    margin-top: 12px;
    font-size: 0.9rem;
    display: none;
}

@media (max-width: 991px) {
    .cx-register-layout {
        grid-template-columns: 1fr;
        gap: 40px;
    }
    .cx-form-row { grid-template-columns: 1fr; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const cxRegForm = document.getElementById('cxRegForm');
    const cxFormMessage = document.getElementById('cxFormMessage');
    
    if (cxRegForm) {
        cxRegForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const submitBtn = cxRegForm.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';
            submitBtn.disabled = true;
            
            const formData = new FormData(cxRegForm);
            const actionUrl = cxRegForm.getAttribute('data-action');
            
            fetch(actionUrl, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                cxFormMessage.style.display = 'block';
                if (data.success) {
                    cxFormMessage.style.color = '#10b981';
                    cxFormMessage.innerHTML = '<i class="fa-solid fa-check-circle"></i> ' + data.message;
                    cxRegForm.reset();
                } else {
                    cxFormMessage.style.color = '#ef4444';
                    cxFormMessage.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i> ' + (data.message || 'An error occurred. Please try again.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                cxFormMessage.style.display = 'block';
                cxFormMessage.style.color = '#ef4444';
                cxFormMessage.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i> Something went wrong. Please check your connection and try again.';
            })
            .finally(() => {
                submitBtn.innerHTML = originalBtnText;
                submitBtn.disabled = false;
                
                // Hide success message after 5 seconds
                setTimeout(() => {
                    if(cxFormMessage.style.color.includes('10b981')) { // if green/success
                        cxFormMessage.style.display = 'none';
                    }
                }, 5000);
            });
        });
    }
});
</script>

