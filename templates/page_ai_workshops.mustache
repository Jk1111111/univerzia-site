<style>
/* Dynamic Impact Stats Section */
.impact-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 40px;
}

.impact-stat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    padding: 40px 30px;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
}

.impact-stat-card:hover {
    transform: translateY(-10px) scale(1.02);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

/* Specific Card Themes */
.impact-stat-card.risk { border-top: 4px solid #ef4444; }
.impact-stat-card.risk .stat-big-number { color: #ef4444; text-shadow: 0 0 20px rgba(239, 68, 68, 0.3); }
.impact-stat-card.risk .stat-icon-wrapper { color: #ef4444; background: rgba(239, 68, 68, 0.1); }

.impact-stat-card.change { border-top: 4px solid #f59e0b; }
.impact-stat-card.change .stat-big-number { color: #f59e0b; text-shadow: 0 0 20px rgba(245, 158, 11, 0.3); }
.impact-stat-card.change .stat-icon-wrapper { color: #f59e0b; background: rgba(245, 158, 11, 0.1); }

.impact-stat-card.opportunity { border-top: 4px solid #10b981; }
.impact-stat-card.opportunity .stat-big-number { color: #10b981; text-shadow: 0 0 20px rgba(16, 185, 129, 0.3); }
.impact-stat-card.opportunity .stat-icon-wrapper { color: #10b981; background: rgba(16, 185, 129, 0.1); }

.stat-icon-wrapper {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 25px;
    transition: all 0.3s ease;
}

.impact-stat-card:hover .stat-icon-wrapper {
    transform: scale(1.1) rotate(5deg);
}

.stat-big-number {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 10px;
    font-family: var(--font-display);
}

.stat-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin-bottom: 15px;
}

.stat-desc {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 30px;
}

.stat-source-badge {
    margin-top: auto;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    gap: 8px;
    font-style: italic;
}

.news-section-new img:hover {
    opacity: 1 !important;
    filter: grayscale(0%) brightness(100%) !important;
}
</style>

