<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/univerziaai/db" VERSION="20260204" COMMENT="XMLDB file for local_univerziaai">
    <TABLES>
        <TABLE NAME="local_univerziaai_contact" COMMENT="Stores contact form submissions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="type" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="student" COMMENT="student or client"/>
                <FIELD NAME="fullname" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="firstname" TYPE="char" LENGTH="100" NOTNULL="false"/>
                <FIELD NAME="lastname" TYPE="char" LENGTH="100" NOTNULL="false"/>
                <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="phone" TYPE="char" LENGTH="50" NOTNULL="false"/>
                <FIELD NAME="country" TYPE="char" LENGTH="100" NOTNULL="false"/>
                <FIELD NAME="department" TYPE="char" LENGTH="50" NOTNULL="false" COMMENT="Academic or Services"/>
                <FIELD NAME="course_or_service" TYPE="char" LENGTH="100" NOTNULL="false"/>
                <FIELD NAME="subject" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Course or Service Name"/>
                <FIELD NAME="details" TYPE="text" NOTNULL="false" COMMENT="JSON or text details like Company Name, Budget, or Status"/>
                <FIELD NAME="message" TYPE="text" NOTNULL="true"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_univerziaai_registrations" COMMENT="Stores workshop registrations and payments">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="firstname" TYPE="char" LENGTH="100" NOTNULL="true"/>
                <FIELD NAME="lastname" TYPE="char" LENGTH="100" NOTNULL="true"/>
                <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="phone" TYPE="char" LENGTH="20" NOTNULL="true"/>
                <FIELD NAME="address" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="workshop_type" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="ai_workshop"/>
                <FIELD NAME="amount" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true"/>
                <FIELD NAME="currency" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="INR"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
                <FIELD NAME="razorpay_order_id" TYPE="char" LENGTH="100" NOTNULL="false"/>
                <FIELD NAME="razorpay_payment_id" TYPE="char" LENGTH="100" NOTNULL="false"/>
                <FIELD NAME="razorpay_signature" TYPE="char" LENGTH="255" NOTNULL="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="email_idx" UNIQUE="false" FIELDS="email"/>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
