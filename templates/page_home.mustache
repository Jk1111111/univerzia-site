<style>
/* Services Tiles Section */
.services-tiles-section {
    padding: 100px 0 80px;
    background: #ffffff;
}

.services-tiles-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-bottom: 50px;
}

.service-tile {
    position: relative;
    height: 320px;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    display: block;
}

.service-tile-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s ease;
}

.service-tile-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.1) 50%, transparent 100%);
    transition: all 0.4s ease;
    z-index: 1;
}

.service-tile-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px 20px;
    z-index: 2;
    transition: all 0.4s ease;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    height: 100%;
}

.service-tile-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    transition: all 0.4s ease;
}

/* Hover Effects */
.service-tile:hover .service-tile-image {
    transform: scale(1.1);
}

.service-tile:hover .service-tile-overlay {
    background: linear-gradient(135deg, rgba(0, 150, 136, 0.85) 0%, rgba(0, 188, 212, 0.85) 100%);
}

.service-tile:hover .service-tile-content {
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.service-tile:hover .service-tile-title {
    text-align: center;
    font-size: 1.35rem;
    text-shadow: 0 3px 15px rgba(0, 0, 0, 0.4);
}

/* Contact Us Button */
.services-cta-center {
    text-align: center;
    margin-top: 20px;
}

.services-contact-btn {
    display: inline-block;
    padding: 16px 50px;
    background: linear-gradient(135deg, #00bfa5 0%, #00897b 100%);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 25px rgba(0, 191, 165, 0.3);
}

.services-contact-btn:hover {
    background: linear-gradient(135deg, #00897b 0%, #00695c 100%);
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0, 191, 165, 0.4);
    color: #ffffff;
    text-decoration: none;
}

/* Responsive */
@media (max-width: 1200px) {
    .services-tiles-grid {
        grid-template-columns: repeat(3, 1fr);
    }
    
    .service-tile {
        height: 280px;
    }
}

@media (max-width: 768px) {
    .services-tiles-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .service-tile {
        height: 260px;
    }
}

@media (max-width: 600px) {
    .services-tiles-section {
        padding: 60px 0 50px;
    }
    
    .services-tiles-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }
    
    .service-tile {
        height: 240px;
    }
    
    .service-tile-title {
        font-size: 1.1rem;
    }
    
    .services-contact-btn {
        padding: 14px 40px;
        font-size: 0.85rem;
    }
}
</style>

