<!-- Registration Modal -->
<div id="registrationModal" class="custom-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.8); z-index: 99999; justify-content: center; align-items: center;">
    <div class="modal-content" style="background: white; width: 90%; max-width: 420px; padding: 30px; border-radius: 16px; position: relative; animation: slideUp 0.3s ease-out; margin: auto;">
        <button onclick="closeRegistrationModal()" style="position: absolute; top: 12px; right: 15px; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--neutral-500);">&times;</button>
        
        <form id="registrationForm">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9rem; color: var(--neutral-700);">First Name *</label>
                    <input type="text" name="firstname" required style="width: 100%; padding: 10px 12px; border: 1px solid var(--neutral-300); border-radius: 8px; font-size: 0.95rem;">
                </div>
                <div>
                    <label style="display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9rem; color: var(--neutral-700);">Last Name *</label>
                    <input type="text" name="lastname" required style="width: 100%; padding: 10px 12px; border: 1px solid var(--neutral-300); border-radius: 8px; font-size: 0.95rem;">
                </div>
            </div>
            
            <div style="margin-bottom: 12px;">
                <label style="display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9rem; color: var(--neutral-700);">Email Address *</label>
                <input type="email" name="email" required style="width: 100%; padding: 10px 12px; border: 1px solid var(--neutral-300); border-radius: 8px; font-size: 0.95rem;">
            </div>
            
            <div style="margin-bottom: 12px;">
                <label style="display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9rem; color: var(--neutral-700);">Phone Number *</label>
                <input type="tel" name="phone" required pattern="[0-9]{10}" style="width: 100%; padding: 10px 12px; border: 1px solid var(--neutral-300); border-radius: 8px; font-size: 0.95rem;" placeholder="10 digit mobile number">
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 4px; font-weight: 600; font-size: 0.9rem; color: var(--neutral-700);">Address</label>
                <input type="text" name="address" style="width: 100%; padding: 10px 12px; border: 1px solid var(--neutral-300); border-radius: 8px; font-size: 0.95rem;" placeholder="Your address (optional)">
            </div>
            
            <div style="background: var(--neutral-100); padding: 12px 15px; border-radius: 10px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 600;">Workshop Fee</span>
                <span style="font-size: 1.4rem; font-weight: 700; color: var(--primary-500);">₹{{payment_amount}}</span>
            </div>
            
            <button type="submit" id="payNowBtn" class="btn-primary" style="width: 100%; padding: 14px; font-size: 1rem; border-radius: 10px; border: none; cursor: pointer;">
                Proceed to Pay ₹{{payment_amount}}
            </button>
        </form>
    </div>
</div>

<!-- Thank You Modal -->
<div id="thankYouModal" class="custom-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1001; justify-content: center; align-items: center;">
    <div class="modal-content" style="background: white; width: 90%; max-width: 450px; padding: 50px 40px; border-radius: 20px; text-align: center; animation: slideUp 0.3s ease-out;">
        <div style="font-size: 4rem; margin-bottom: 20px;"><i class="fa-solid fa-circle-check"></i></div>
        <h2 style="color: var(--success); margin-bottom: 15px;">Payment Successful!</h2>
        <p style="color: var(--neutral-600); margin-bottom: 10px; line-height: 1.6;">Thank you for registering for the AI Workshop!</p>
        <p id="thankYouEmail" style="color: var(--neutral-600); margin-bottom: 25px;">A confirmation email has been sent to your registered email.</p>
        <button onclick="closeThankYouModal()" class="btn-primary" style="padding: 12px 40px; border-radius: 50px; border: none; cursor: pointer; font-size: 1rem;">Got it!</button>
    </div>
</div>

<!-- Razorpay Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    // Config from server
    const PAYMENT_ENDPOINT = '{{payment_endpoint}}';
    const RAZORPAY_KEY = '{{razorpay_key}}';
    const PAYMENT_AMOUNT = {{payment_amount}};
    const BUSINESS_NAME = '{{business_name}}';
    
    // Modal elements
    const registrationModal = document.getElementById('registrationModal');
    const thankYouModal = document.getElementById('thankYouModal');
    const registrationForm = document.getElementById('registrationForm');
    const payNowBtn = document.getElementById('payNowBtn');
    
    // Open registration modal
    document.querySelectorAll('.register-workshop-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            registrationModal.style.display = 'flex';
        });
    });
    
    function closeRegistrationModal() {
        registrationModal.style.display = 'none';
    }
    
    function closeThankYouModal() {
        thankYouModal.style.display = 'none';
    }
    
    // Close modals on outside click
    window.addEventListener('click', (e) => {
        if (e.target === registrationModal) closeRegistrationModal();
        if (e.target === thankYouModal) closeThankYouModal();
    });
    
    // Handle form submission
    registrationForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        payNowBtn.disabled = true;
        payNowBtn.textContent = 'Processing...';
        
        const formData = new FormData(registrationForm);
        formData.append('action', 'createorder');
        formData.append('workshop_type', 'ai_workshop');
        formData.append('amount', PAYMENT_AMOUNT);
        
        try {
            const response = await fetch(PAYMENT_ENDPOINT, {
                method: 'POST',
                body: formData
            });
            
            const data = await response.json();
            
            if (!data.success) {
                throw new Error(data.error || 'Failed to create order');
            }
            
            // Open Razorpay checkout
            const options = {
                key: RAZORPAY_KEY,
                amount: data.amount,
                currency: data.currency,
                name: BUSINESS_NAME,
                description: 'AI Workshop Registration',
                order_id: data.order_id,
                prefill: data.prefill,
                theme: {
                    color: '#F08042'
                },
                handler: async function(response) {
                    // Verify payment
                    const verifyData = new FormData();
                    verifyData.append('action', 'verifypayment');
                    verifyData.append('razorpay_order_id', response.razorpay_order_id);
                    verifyData.append('razorpay_payment_id', response.razorpay_payment_id);
                    verifyData.append('razorpay_signature', response.razorpay_signature);
                    verifyData.append('registration_id', data.registration_id);
                    
                    const verifyResponse = await fetch(PAYMENT_ENDPOINT, {
                        method: 'POST',
                        body: verifyData
                    });
                    
                    const verifyResult = await verifyResponse.json();
                    
                    if (verifyResult.success) {
                        closeRegistrationModal();
                        document.getElementById('thankYouEmail').textContent = 
                            'A confirmation email has been sent to ' + verifyResult.registration.email;
                        thankYouModal.style.display = 'flex';
                        registrationForm.reset();
                    } else {
                        alert('Payment verification failed. Please contact support.');
                    }
                },
                modal: {
                    ondismiss: function() {
                        payNowBtn.disabled = false;
                        payNowBtn.textContent = 'Proceed to Pay ₹' + PAYMENT_AMOUNT;
                    }
                }
            };
            
            const rzp = new Razorpay(options);
            rzp.open();
            
        } catch (error) {
            console.error('Payment error:', error);
            alert('Error: ' + error.message);
        }
        
        payNowBtn.disabled = false;
        payNowBtn.textContent = 'Proceed to Pay ₹' + PAYMENT_AMOUNT;
    });
</script>

