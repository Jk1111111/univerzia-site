{{!
    Services page template for UniverziaAi
}}
{{> local_univerziaai/navbar }}

<!-- Services Hero -->
<section class="page-hero" style="padding-top: 160px; padding-bottom: 80px; background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%);">
    <div class="container">
        <div style="text-align: center;">
            <div class="badge">Our Services</div>
            <h1 class="hero-title">Comprehensive <span class="gradient-text">Digital Solutions</span></h1>
            <p class="hero-subtitle" style="max-width: 700px; margin: 0 auto;">
                From stunning websites to powerful e-commerce platforms, we deliver end-to-end digital services that drive growth.
            </p>
        </div>
    </div>
</section>

<!-- Services Grid -->
<section style="padding: 80px 0;">
    <div class="container">
        <div class="services-category-grid">
            {{#service_categories}}
            <a href="{{{page_{{id}}}}}" class="service-cat-card" style="text-decoration: none; color: inherit;">
                <div class="cat-icon-box">{{{icon}}}</div>
                <h3 class="cat-title">{{title}}</h3>
                <p style="color: var(--neutral-600); margin-bottom: 20px;">{{description}}</p>
                <ul class="cat-list">
                    {{#features}}
                    <li>{{.}}</li>
                    {{/features}}
                </ul>
            </a>
            {{/service_categories}}
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section style="padding: 80px 0; background: var(--neutral-100);">
    <div class="container">
        <div class="section-header-center">
            <h2 class="section-title">Why Choose <span class="gradient-text">UniverziaAi?</span></h2>
        </div>
        <div class="why-us-grid">
            {{#why_us}}
            <div class="why-card">
                <div class="why-icon">{{{icon}}}</div>
                <h3 class="why-title">{{title}}</h3>
                <p style="color: var(--neutral-600);">{{description}}</p>
            </div>
            {{/why_us}}
        </div>
    </div>
</section>

<!-- CTA Section -->
<section style="padding: 100px 0;">
    <div class="container">
        <div class="cta-box" style="background: linear-gradient(135deg, var(--primary-600), var(--primary-500)); border-radius: 24px; padding: 60px; text-align: center; color: white;">
            <h2 style="color: white; margin-bottom: 20px;">Ready to Start Your Project?</h2>
            <p style="color: rgba(255,255,255,0.9); margin-bottom: 30px; font-size: 1.2rem;">
                Let's discuss your requirements and create something amazing together.
            </p>
            <a href="{{{page_contact}}}" class="btn-secondary btn-large" style="background: white; color: var(--primary-600);">Contact Us Today</a>
        </div>
    </div>
</section>

{{> local_univerziaai/footer }}
