            <!-- Service 6 -->
            <div class="service-card">
                <div class="service-icon" style="background: linear-gradient(135deg, #fce7f3, #fbcfe8);">
                    <i class="fa-solid fa-server" style="color: #ec4899;"></i>
                </div>
