{{!
    Website Development page template for UniverziaAi
}}
{{> local_univerziaai/navbar }}

<!-- Hero -->
<section class="page-hero" style="padding-top: 160px; padding-bottom: 80px; background: linear-gradient(135deg, #dbeafe 0%, #ffffff 100%);">
    <div class="container">
        <div style="text-align: center;">
            <div class="badge"><i class="fa-solid fa-laptop-code"></i> Web Development</div>
            <h1 class="hero-title">{{hero_title}}</h1>
            <p class="hero-subtitle" style="max-width: 700px; margin: 0 auto;">{{hero_subtitle}}</p>
        </div>
    </div>
</section>

<!-- Technologies -->
<section style="padding: 80px 0;">
    <div class="container">
        <div class="section-header-center">
            <h2 class="section-title">Technologies <span class="gradient-text">We Use</span></h2>
        </div>
        <div style="display: flex; justify-content: center; gap: 30px; flex-wrap: wrap;">
            {{#technologies}}
            <div style="background: white; padding: 20px 40px; border-radius: 12px; box-shadow: var(--shadow-md); font-weight: 600;">{{.}}</div>
            {{/technologies}}
        </div>
    </div>
</section>

<!-- Services -->
<section style="padding: 100px 0; background: var(--neutral-100);">
    <!-- ... (existing services content) ... -->
    <div class="container">
        <div class="section-header-center" style="margin-bottom: 60px;">
            <p style="color: #ef4444; font-weight: 700; font-size: 0.9rem; letter-spacing: 1px; margin-bottom: 10px; text-transform: uppercase;">// WHAT WE'RE OFFERING</p>
            <h2 class="section-title" style="font-size: 2.5rem;">Services we're offering in <br><span class="gradient-text">Web Development</span></h2>
        </div>

        <div class="services-grid">
            {{#services}}
            <div class="service-card">
                <div class="dotted-pattern"></div>
                <h3 class="service-title">{{title}}</h3>
                <p class="service-desc">{{description}}</p>
                
                <div class="service-footer">
                    <div class="read-more-wrapper">
                        <span class="read-more-text">Read more</span>
                        <span class="read-more-arrow"><i class="fa-solid fa-arrow-right"></i></span>
                    </div>
                    <div class="service-icon-circle">
                        <i class="{{icon_class}}"></i>
                    </div>
                </div>
            </div>
            {{/services}}
        </div>
    </div>
</section>

<!-- Industry Customized Services -->
<section class="industry-section">
    <div class="industry-container">
        <div class="industry-image-side" style="background-image: url('{{industry_image}}');">
            <div class="industry-overlay">
                <div class="neon-text-wrapper">
                    <span class="neon-text">WEBSITE</span>
                    <div class="neon-lines">
                        <span class="line line-1"></span>
                        <span class="line line-2"></span>
                        <span class="line line-3"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="industry-content-side">
            <div class="industry-content-wrapper">
                {{#industry_features}}
                <p class="section-tag">{{header_small}}</p>
                <h2 class="industry-title">{{title}}</h2>
                <p class="highlight-question">{{highlight_question}}</p>
                <p class="industry-desc">{{description}}</p>
                
                <div class="features-grid-small">
                    {{#features}}
                    <div class="feature-item-small">
                        <div class="feature-icon-small" style="color: {{color}}; border-color: {{color}}; box-shadow: 0 0 10px {{color}}40;">
                            <i class="{{icon}}"></i>
                        </div>
                        <span class="feature-title-small">{{title}}</span>
                    </div>
                    {{/features}}
                </div>
                {{/industry_features}}
            </div>
        </div>
    </div>
</section>

<style>
/* Industry Section Styles */
.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 30px;
}

.service-card {
    background: white;
    border-radius: 12px;
    padding: 40px 30px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.03);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid #f1f1f1;
    display: flex;
    flex-direction: column;
    min-height: 320px;
}

.service-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
}

/* Dotted Pattern */
.dotted-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 120px;
    height: 120px;
    background-image: radial-gradient(#e5e7eb 1.5px, transparent 1.5px);
    background-size: 15px 15px;
    opacity: 0.6;
}

.service-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--neutral-900);
    margin-bottom: 15px;
    position: relative;
    z-index: 1;
}

.service-desc {
    color: var(--neutral-600);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 40px;
    position: relative;
    z-index: 1;
    flex-grow: 1;
}

.service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
}

.read-more-wrapper {
    display: flex;
    align-items: center;
    gap: 15px;
    cursor: pointer;
}

.read-more-text {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neutral-600);
    transition: color 0.3s ease;
}

.read-more-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: white;
    border: 1px solid var(--neutral-200); /* Thin border initially */
    color: var(--neutral-900);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    transition: all 0.3s ease;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.service-card:hover .read-more-text {
    color: var(--neutral-900);
}

.service-card:hover .read-more-arrow {
    background: #ef4444; /* Matches red tone */
    color: white;
    border-color: #ef4444;
}

.service-icon-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #fef2f2; /* Light red/pink bg */
    color: #ef4444; /* Red icon */
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    transition: all 0.4s ease;
    position: relative;
}

/* Creating the large circle effect behind the icon if needed, but CSS circle is cleaner */
.service-icon-circle::before {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: #fef2f2;
    z-index: -1;
    opacity: 0.5;
    transform: scale(0.8);
    transition: all 0.4s ease;
}

.service-card:hover .service-icon-circle {
    background: #ef4444;
    color: white;
    transform: scale(1.1);
}

.service-card:hover .service-icon-circle::before {
    transform: scale(1.4);
    opacity: 0.2;
    background: #ef4444;
}

/* Industry Section Styles */
.industry-section {
    padding: 0;
    overflow: hidden;
}

.industry-container {
    display: flex;
    min-height: 600px;
}

.industry-image-side {
    flex: 1;
    background-size: cover;
    background-position: center;
    position: relative;
    min-height: 400px;
}

.industry-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.6); /* Dark blue overlay */
    display: flex;
    align-items: center;
    justify-content: center;
}

.neon-text-wrapper {
    position: relative;
    border: 4px solid #00ffcc;
    padding: 20px 40px;
    box-shadow: 0 0 20px #00ffcc, inset 0 0 20px #00ffcc;
    transform: rotate(-5deg);
}

.neon-text {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 2px #00ffcc;
    letter-spacing: 5px;
    filter: drop-shadow(0 0 5px #00ffcc);
}

.industry-content-side {
    flex: 1;
    background: #0f172a; /* Dark slate */
    color: white;
    display: flex;
    align-items: center;
    padding: 80px;
}

.industry-content-wrapper {
    max-width: 600px;
}

.section-tag {
    color: #ef4444;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 2px;
    margin-bottom: 20px;
    text-transform: uppercase;
}

.industry-title {
    font-size: 2.5rem;
    color: white;
    margin-bottom: 25px;
    line-height: 1.2;
}

.highlight-question {
    color: #ef4444;
    font-size: 1.1rem;
    margin-bottom: 20px;
    font-weight: 500;
}

.industry-desc {
    color: rgba(255,255,255,0.7);
    line-height: 1.8;
    margin-bottom: 50px;
}

.features-grid-small {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
}

.feature-item-small {
    display: flex;
    align-items: center;
    gap: 15px;
}

.feature-icon-small {
    width: 50px;
    height: 50px;
    border: 2px solid; /* Color driven by inline style */
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    background: rgba(255,255,255,0.05);
    transition: all 0.3s ease;
}

.feature-item-small:hover .feature-icon-small {
    transform: scale(1.1);
    background: rgba(255,255,255,0.1);
}

.feature-title-small {
    font-weight: 700;
    font-size: 1rem;
}

@media (max-width: 992px) {
    .industry-container {
        flex-direction: column;
    }
    .industry-image-side {
        min-height: 300px;
    }
    .industry-content-side {
        padding: 60px 30px;
    }
}
</style>

<!-- Company Strategies Section -->
<section class="strategies-section">
    <div class="container">
        {{#company_strategies}}
        <div class="strategies-header-center">
            <p class="section-tag">{{header_small}}</p>
            <h2 class="section-title">{{title}}</h2>
            <p class="section-desc-center">{{description}}</p>
        </div>

        <div class="strategies-layout">
            <!-- Left Column: Visual Highlights (Side-by-Side) -->
            <div class="strategies-left">
                <div class="highlights-row">
                    {{#highlights}}
                    <div class="highlight-card">
                        <div class="highlight-icon-wrapper" style="color: {{color}}; background: {{color}}15;">
                            <i class="{{icon}}"></i>
                        </div>
                        <h3 class="highlight-title">{{title}}</h3>
                        <p class="highlight-desc">{{desc}}</p>
                    </div>
                    {{/highlights}}
                </div>
            </div>

            <!-- Right Column: Strategy Accordion -->
            <div class="strategies-right">
                <div class="strategy-accordion">
                    {{#strategies}}
                    <div class="strategy-acc-item">
                        <div class="strategy-acc-header">
                            <h3 class="strategy-title">{{title}}</h3>
                            <div class="strategy-arrow">
                                <i class="fa-solid fa-chevron-down"></i>
                            </div>
                        </div>
                        <div class="strategy-acc-body">
                            <div class="strategy-content-inner">
                                <p class="strategy-text">{{content}}</p>
                            </div>
                        </div>
                    </div>
                    {{/strategies}}
                </div>
            </div>
        </div>
        {{/company_strategies}}
    </div>
</section>

<style>
.strategies-section {
    padding: 100px 0;
    background: #ffffff;
}

.strategies-header-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 60px;
}

.section-desc-center {
    color: var(--neutral-600);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-top: 20px;
}

.strategies-layout {
    display: flex;
    gap: 40px;
    align-items: flex-start;
}

.strategies-left {
    flex: 5;
}

.highlights-row {
    display: flex; /* Side-by-side layout */
    gap: 20px;
}

.highlight-card {
    background: white;
    padding: 30px 20px;
    border-radius: 12px;
    box-shadow: 0 5px 25px rgba(0,0,0,0.05);
    text-align: center;
    border: 1px solid var(--neutral-100);
    flex: 1; /* Equal width */
    transition: transform 0.3s ease;
}

.highlight-card:hover {
    transform: translateY(-5px);
}

.highlight-icon-wrapper {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

.highlight-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--neutral-900);
    line-height: 1.3;
}

.highlight-desc {
    font-size: 0.9rem;
    color: var(--neutral-600);
    line-height: 1.5;
}

/* Accordion Styles */
.strategies-right {
    flex: 6;
}

.strategy-accordion {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.strategy-acc-item {
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid var(--neutral-200);
    overflow: hidden;
    transition: all 0.3s ease;
}

.strategy-acc-item.active {
    background: white;
    border-color: var(--neutral-200);
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
}

.strategy-acc-header {
    padding: 20px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    background: transparent;
    transition: background 0.2s;
}

.strategy-acc-header:hover {
    background: rgba(0,0,0,0.01);
}

.strategy-acc-item.active .strategy-acc-header {
    border-bottom: 1px solid var(--neutral-100);
}

.strategy-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--neutral-900);
    margin: 0;
}

.strategy-arrow {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--neutral-400);
    transition: transform 0.3s ease;
}

.strategy-acc-item.active .strategy-arrow {
    transform: rotate(180deg);
    color: #ef4444;
}

.strategy-acc-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-out;
}

.strategy-content-inner {
    padding: 25px;
    padding-top: 10px;
}

.strategy-text {
    color: var(--neutral-600);
    line-height: 1.6;
    margin: 0;
}

@media (max-width: 992px) {
    .strategies-layout {
        flex-direction: column;
    }
    .highlights-row {
        flex-direction: column;
    }
    .strategies-left, .strategies-right {
        flex: 1;
        width: 100%;
    }
}
</style>

<!-- Industries Section -->
<section style="padding: 100px 0; background: #f8fafc;">
    <div class="container">
        {{#industries}}
        <div class="strategies-header-center">
            <h2 class="section-title">{{title}}</h2>
            <p class="section-desc-center">{{description}}</p>
        </div>

        <div class="industries-grid">
            {{#items}}
            <div class="industry-card" style="--hover-color: {{color}};">
                <div class="industry-content">
                    <div class="industry-icon-wrapper">
                        <i class="{{icon}}"></i>
                    </div>
                    <h3 class="industry-title">{{title}}</h3>
                    <div class="industry-desc-wrapper">
                        <p class="industry-desc-text">{{desc}}</p>
                    </div>
                </div>
            </div>
            {{/items}}
        </div>
        {{/industries}}
    </div>
</section>

<!-- Registration Form Section -->
<section style="padding: 100px 0; background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);">
    <div class="container">
        <div class="registration-wrapper">
            <!-- Left Side: Content -->
            <div class="registration-content-side">
                <div class="reg-content-inner">
                    <span class="badge-pill">Start Your Project</span>
                    <h2 class="reg-title">Let's Build Something <span class="gradient-text">Amazing</span></h2>
                    <p class="reg-subtitle">
                        Ready to transform your digital presence? Whether you need a high-performance website, a custom application, or an AI-driven solution, our team is here to help.
                    </p>
                    
                    <div class="reg-perks">
                        <div class="reg-perk-item">
                            <div class="perk-icon"><i class="fa-solid fa-check"></i></div>
                            <span>Free Initial Consultation</span>
                        </div>
                        <div class="reg-perk-item">
                            <div class="perk-icon"><i class="fa-solid fa-check"></i></div>
                            <span>Tailored Digital Strategy</span>
                        </div>
                        <div class="reg-perk-item">
                            <div class="perk-icon"><i class="fa-solid fa-check"></i></div>
                            <span>Transparent Pricing & Timeline</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Form -->
            <div class="registration-form-side">
                <div class="form-card" id="registrationFormContainer">
                    <h3 class="form-title">Get in Touch</h3>
                    <form id="admissionForm" class="admission-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="firstName">First Name</label>
                                <input type="text" id="firstName" name="firstname" required placeholder="John">
                            </div>
                            <div class="form-group">
                                <label for="lastName">Last Name</label>
                                <input type="text" id="lastName" name="lastname" required placeholder="Doe">
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="email">Email Address</label>
                                <input type="email" id="email" name="email" required placeholder="john@example.com">
                            </div>
                            <div class="form-group">
                                <label for="phone">Phone</label>
                                <input type="tel" id="phone" name="phone" placeholder="+91 9876543210">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label for="country">Country</label>
                            <input type="text" id="country" name="country" placeholder="India">
                        </div>
                        
                        <div class="form-group">
                            <label>I am interested in:</label>
                            <div class="department-options">
                                <label class="radio-container">Academic
                                    <input type="radio" name="department" value="Academic" checked>
                                    <span class="checkmark"></span>
                                </label>
                                <label class="radio-container">Services
                                    <input type="radio" name="department" value="Services">
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                        </div>
                        
                        <!-- Dynamic Dropdown Container -->
                        <div class="form-group" id="courseServiceContainer">
                            <label id="dropdownLabel">Select Course</label>
                            <select id="courseServiceSelect" name="course_service" required>
                                <option value="">Select Option</option>
                                {{#admission_form_options.academic}}
                                <option value="{{.}}">{{.}}</option>
                                {{/admission_form_options.academic}}
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="message">Message (Optional)</label>
                            <textarea id="message" name="message" rows="3" placeholder="Tell us about your project..."></textarea>
                        </div>
                        
                        <button type="submit" class="apply-btn">
                            <i class="fa-solid fa-paper-plane"></i> Send Request
                        </button>
                        
                        <div id="formMessage" class="form-message"></div>
                    </form>
                </div>

                <!-- Success State -->
                <div class="reg-success-card" id="registrationSuccessContainer" style="display: none;">
                    <div class="success-icon-wrapper">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h3>Request Sent!</h3>
                    <p>Thank you for reaching out. We have received your details and will contact you shortly.</p>
                    <button id="registerAnotherBtn" class="apply-btn btn-outline">Send Another</button>
                </div>
            </div>
        </div>
    </div>
</section>

{{> local_univerziaai/footer }}

<style>
/* Registration Section Styles */
.registration-wrapper {
    display: flex;
    background: white;
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.05); /* Deep shadow */
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.03);
}

.registration-content-side {
    flex: 4;
    background: var(--neutral-900);
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: white;
    position: relative;
    overflow: hidden;
    text-align: left; /* Ensure left alignment */
}

/* Background Pattern/Overlay for Left Side */
.registration-content-side::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(rgba(255,255,255,0.1) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.3;
}

.reg-content-inner {
    position: relative;
    z-index: 1;
}

.badge-pill {
    display: inline-block;
    padding: 6px 14px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: #00ffcc; /* Neon accent */
}

.reg-title {
    font-size: 2.5rem;
    margin-bottom: 20px;
    line-height: 1.2;
}

.reg-subtitle {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
    margin-bottom: 40px;
}

.reg-perks {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.reg-perk-item {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 1rem;
    color: rgba(255,255,255,0.9);
}

.perk-icon {
    width: 24px;
    height: 24px;
    background: #00ffcc;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--neutral-900);
    font-size: 0.7rem;
    flex-shrink: 0;
}

/* Form Side */
.registration-form-side {
    flex: 6;
    padding: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.form-card {
    width: 100%;
    max-width: 500px;
}

.form-title {
    font-size: 1.5rem;
    margin-bottom: 30px;
    color: var(--neutral-900);
}

.admission-form .form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
}

.admission-form .form-group {
    flex: 1;
    margin-bottom: 20px;
}

.admission-form label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neutral-700);
    margin-bottom: 8px;
    text-align: left; /* Ensure label alignment */
}

.admission-form input[type="text"],
.admission-form input[type="email"],
.admission-form input[type="tel"],
.admission-form select,
.admission-form textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #334155;
    transition: all 0.3s ease;
    background: #f8fafc;
}

.admission-form input:focus,
.admission-form select:focus,
.admission-form textarea:focus {
    outline: none;
    border-color: var(--primary-500);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

/* Radio Button Styles */
.department-options {
    display: flex;
    gap: 30px;
    margin-top: 10px;
    justify-content: flex-start; /* Ensure left alignment for radios */
}

.radio-container {
    display: block;
    position: relative;
    padding-left: 30px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--neutral-700);
    user-select: none;
}

.radio-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
}

.checkmark {
    position: absolute;
    top: 2px;
    left: 0;
    height: 18px;
    width: 18px;
    background-color: #f1f5f9;
    border: 2px solid #cbd5e1;
    border-radius: 50%;
    transition: all 0.2s ease;
}

.radio-container:hover input ~ .checkmark {
    background-color: #e2e8f0;
}

.radio-container input:checked ~ .checkmark {
    background-color: var(--primary-600);
    border-color: var(--primary-600);
}

.radio-container input:checked ~ .checkmark:after {
    display: block;
}

.checkmark:after {
    content: "";
    position: absolute;
    display: none;
    top: 4px;
    left: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
}

.apply-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 32px;
    background: var(--neutral-900); 
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    margin-top: 10px;
}

.apply-btn:hover {
    background: #000;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}

.btn-outline {
    background: transparent;
    border: 2px solid var(--neutral-900);
    color: var(--neutral-900);
}

.btn-outline:hover {
    background: var(--neutral-900);
    color: white;
}

.form-message {
    margin-top: 20px;
    font-size: 0.9rem;
    text-align: center;
    min-height: 20px;
}

.form-message.success { color: #10b981; }
.form-message.error { color: #ef4444; }

/* Success Card */
.reg-success-card {
    text-align: center;
    padding: 40px;
    animation: fadeIn 0.5s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.success-icon-wrapper {
    width: 80px;
    height: 80px;
    background: #d1fae5;
    color: #10b981;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin-bottom: 25px;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 992px) {
    .registration-wrapper {
        flex-direction: column;
    }
    .registration-content-side, .registration-form-side {
        flex: 1;
        padding: 40px;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const departmentRadios = document.querySelectorAll('input[name="department"]');
    const dropdownLabel = document.getElementById('dropdownLabel');
    const courseServiceSelect = document.getElementById('courseServiceSelect');
    
    // Data from Mustache
    const academicOptions = [
        {{#admission_form_options.academic}}
        "{{.}}",
        {{/admission_form_options.academic}}
    ];
    
    const serviceOptions = [
        {{#admission_form_options.services}}
        "{{.}}",
        {{/admission_form_options.services}}
    ];
    
    function updateDropdown(dept) {
        // Clear existing
        courseServiceSelect.innerHTML = '<option value="">Select Option</option>';
        
        let options = [];
        if (dept === 'Academic') {
            dropdownLabel.textContent = 'Select Course';
            options = academicOptions;
        } else {
            dropdownLabel.textContent = 'Select Service';
            options = serviceOptions;
        }
        
        options.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt;
            option.textContent = opt;
            courseServiceSelect.appendChild(option);
        });
    }
    
    departmentRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
            updateDropdown(e.target.value);
        });
    });
    
    // Form Submission
    const form = document.getElementById('admissionForm');
    const messageDiv = document.getElementById('formMessage');
    const submitBtn = form.querySelector('.apply-btn');
    const formContainer = document.getElementById('registrationFormContainer');
    const successContainer = document.getElementById('registrationSuccessContainer');
    const registerAnotherBtn = document.getElementById('registerAnotherBtn');
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
        messageDiv.textContent = '';
        messageDiv.className = 'form-message';
        
        const formData = new FormData(form);
        
        fetch('{{{pluginurl}}}/ajax_submit_admission.php', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Show success container
                formContainer.style.display = 'none';
                successContainer.style.display = 'flex';
                
                form.reset();
                updateDropdown('Academic');
            } else {
                messageDiv.textContent = data.message || 'An error occurred.';
                messageDiv.classList.add('error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            messageDiv.textContent = 'Network error. Please try again.';
            messageDiv.classList.add('error');
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Send Request';
        });
    });
    
    if (registerAnotherBtn) {
        registerAnotherBtn.addEventListener('click', function() {
            successContainer.style.display = 'none';
            formContainer.style.display = 'block';
            messageDiv.textContent = '';
        });
    }
});
</script>

