<style>
/* Why Choose Us Section */
.lms-why-section {
    padding: 100px 0;
    background: #fff;
    overflow: hidden;
}

.why-row {
    display: flex;
    align-items: center;
    gap: 80px;
    flex-wrap: wrap;
}

.why-content {
    flex: 1 1 450px;
    max-width: 550px;
}

.why-tag {
    display: inline-block;
    background: rgba(220, 38, 38, 0.08);
    color: #dc2626;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
}

.why-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.2;
    margin-bottom: 32px;
}

/* Accordion */
.why-accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.accordion-item {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    transition: all 0.3s ease;
}

.accordion-item.active {
    border-color: #dc2626;
    background: #fef2f2;
}

.accordion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    cursor: pointer;
    font-weight: 600;
    color: #1a1a1a;
    font-size: 0.95rem;
}

.accordion-header i {
    color: #9ca3af;
    font-size: 0.8rem;
    transition: transform 0.3s ease;
}

.accordion-item.active .accordion-header i {
    transform: rotate(180deg);
    color: #dc2626;
}

.accordion-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
}

.accordion-item.active .accordion-body {
    max-height: 200px;
    padding: 0 20px 16px;
}

.accordion-body p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #6b7280;
    margin: 0;
}

/* Why Images */
.why-images {
    flex: 1 1 400px;
    position: relative;
}

.why-img-wrapper {
    position: relative;
    min-height: 450px;
}

.why-img-card {
    position: absolute;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}

.why-img-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.why-img-card.img-a {
    width: 280px;
    height: 200px;
    top: 0;
    right: 20px;
    z-index: 2;
}

.why-img-card.img-b {
    width: 260px;
    height: 220px;
    bottom: 40px;
    left: 20px;
    z-index: 1;
}

.why-deco-ring {
    position: absolute;
    width: 100px;
    height: 100px;
    border: 4px solid #dc2626;
    border-radius: 50%;
    top: -20px;
    right: -10px;
    z-index: 0;
    animation: why-ring-pulse 4s ease-in-out infinite;
}

.why-deco-circle {
    position: absolute;
    width: 60px;
    height: 60px;
    background: #f97316;
    border-radius: 50%;
    bottom: 80px;
    right: 60px;
    z-index: 0;
    animation: why-circle-float 5s ease-in-out infinite;
}

.why-deco-dots {
    position: absolute;
    width: 80px;
    height: 80px;
    background-image: radial-gradient(circle, #9ca3af 1.5px, transparent 1.5px);
    background-size: 10px 10px;
    top: 40%;
    left: 0;
    opacity: 0.5;
    animation: why-dots-drift 6s ease-in-out infinite alternate;
}

/* Subtle Animations for Decorative Elements */
@keyframes why-ring-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.8; }
}

@keyframes why-circle-float {
    0%, 100% { transform: translateY(0) translateX(0); }
    50% { transform: translateY(-8px) translateX(4px); }
}

@keyframes why-dots-drift {
    0% { transform: translateY(0); opacity: 0.5; }
    100% { transform: translateY(-10px); opacity: 0.7; }
}

@media (max-width: 992px) {
    .why-row {
        flex-direction: column;
    }
    
    .why-content {
        max-width: 100%;
        text-align: center;
    }
    
    .why-accordion {
        text-align: left;
    }
    
    .why-img-wrapper {
        min-height: 380px;
    }
    
    .why-img-card.img-a { right: 10%; }
    .why-img-card.img-b { left: 10%; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const accordionItems = document.querySelectorAll('.accordion-item');
    accordionItems.forEach(item => {
        item.querySelector('.accordion-header').addEventListener('click', function() {
            const isActive = item.classList.contains('active');
            accordionItems.forEach(i => i.classList.remove('active'));
            if (!isActive) {
                item.classList.add('active');
            }
        });
    });
});
</script>

<!-- Get in Touch Section -->
<section class="lms-contact-section">
    <div class="container">
        <div class="contact-wrapper">
            <!-- Left Side: Content -->
            <div class="contact-content-side">
                <div class="contact-content-inner">
                    <span class="contact-badge">Start Your Project</span>
                    <h2 class="contact-title">Let's Build Something <span class="contact-gradient">Amazing</span></h2>
                    <p class="contact-subtitle">
                        Ready to transform your digital learning experience? Whether you need LMS customization, theme design, or custom development, our team is here to help.
                    </p>
                    
                    <div class="contact-perks">
                        <div class="contact-perk-item">
                            <div class="contact-perk-icon"><i class="fa-solid fa-check"></i></div>
                            <span>Free Initial Consultation</span>
                        </div>
                        <div class="contact-perk-item">
                            <div class="contact-perk-icon"><i class="fa-solid fa-check"></i></div>
                            <span>Tailored LMS Solutions</span>
                        </div>
                        <div class="contact-perk-item">
                            <div class="contact-perk-icon"><i class="fa-solid fa-check"></i></div>
                            <span>Transparent Pricing & Timeline</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Form -->
            <div class="contact-form-side">
                <div class="contact-form-card" id="lmsFormContainer">
                    <h3 class="contact-form-title">Get in Touch</h3>
                    <form id="lmsAdmissionForm" class="lms-admission-form">
                        <div class="lms-form-row">
                            <div class="lms-form-group">
                                <label for="lmsFirstName">First Name</label>
                                <input type="text" id="lmsFirstName" name="firstname" required placeholder="John">
                            </div>
                            <div class="lms-form-group">
                                <label for="lmsLastName">Last Name</label>
                                <input type="text" id="lmsLastName" name="lastname" required placeholder="Doe">
                            </div>
                        </div>
                        
                        <div class="lms-form-row">
                            <div class="lms-form-group">
                                <label for="lmsEmail">Email Address</label>
                                <input type="email" id="lmsEmail" name="email" required placeholder="john@example.com">
                            </div>
                            <div class="lms-form-group">
                                <label for="lmsPhone">Phone</label>
                                <input type="tel" id="lmsPhone" name="phone" placeholder="+91 9876543210">
                            </div>
                        </div>
                        
                        <div class="lms-form-group">
                            <label for="lmsCountry">Country</label>
                            <input type="text" id="lmsCountry" name="country" placeholder="India">
                        </div>
                        
                        <div class="lms-form-group">
                            <label>I am interested in:</label>
                            <div class="lms-department-options">
                                <label class="lms-radio-container">
                                    <input type="radio" name="department" value="Academic" checked>
                                    <span class="lms-checkmark"></span>
                                    <span class="lms-radio-text">Academic</span>
                                </label>
                                <label class="lms-radio-container">
                                    <input type="radio" name="department" value="Services">
                                    <span class="lms-checkmark"></span>
                                    <span class="lms-radio-text">Services</span>
                                </label>
                            </div>
                        </div>
                        
                        <div class="lms-form-group" id="lmsCourseServiceContainer">
                            <label id="lmsDropdownLabel">Select Course</label>
                            <select id="lmsCourseServiceSelect" name="course_service" required>
                                <option value="">Select Option</option>
                                {{#admission_form_options.academic}}
                                <option value="{{.}}">{{.}}</option>
                                {{/admission_form_options.academic}}
                            </select>
                        </div>
                        
                        <div class="lms-form-group">
                            <label for="lmsMessage">Message (Optional)</label>
                            <textarea id="lmsMessage" name="message" rows="3" placeholder="Tell us about your project..."></textarea>
                        </div>
                        
                        <button type="submit" class="lms-apply-btn">
                            <i class="fa-solid fa-paper-plane"></i> Send Request
                        </button>
                        
                        <div id="lmsFormMessage" class="lms-form-message"></div>
                    </form>
                </div>

                <!-- Success State -->
                <div class="lms-success-card" id="lmsSuccessContainer" style="display: none;">
                    <div class="lms-success-icon">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h3>Request Sent!</h3>
                    <p>Thank you for reaching out. We have received your details and will contact you shortly.</p>
                    <button id="lmsSendAnotherBtn" class="lms-apply-btn lms-btn-outline">Send Another</button>
                </div>
            </div>
        </div>
    </div>
</section>

