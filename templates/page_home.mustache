    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
}

.nav-card {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e2e8f0;
}

.nav-controls {
    display: flex;
    align-items: center;
    gap: 16px;
}

.nav-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #1a2a3a;
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s ease;
}

.nav-arrow:hover {
    background: #2d4a5e;
}

.nav-counter {
    font-size: 1.1rem;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 1px;
}

